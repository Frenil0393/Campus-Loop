@model List<Product>
@{
    ViewData["Title"] = "Moderate Products";
    var categories = ViewBag.Categories as Dictionary<int, string> ?? new Dictionary<int, string>();
    var sellers = ViewBag.Sellers as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <nav style="font-size: 13px;" class="mb-1">
                <a asp-controller="Admin" asp-action="Index" class="apple-link">Admin Dashboard</a> / Products
            </nav>
            <h1 class="fs-3 fw-bold mb-0">Product Moderation</h1>
        </div>
        <span class="badge rounded-pill bg-light text-dark border px-3 py-2">
            Total Listings: @Model.Count
        </span>
    </div>

    <div class="apple-form-card p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Seller</th>
                        <th>Status</th>
                        <th>Posted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var categoryName = categories.ContainsKey(p.CategoryId) ? categories[p.CategoryId] : "General";
                        var sellerName = sellers.ContainsKey(p.SellerId) ? sellers[p.SellerId] : "Student";

                        <tr>
                            <td class="fw-semibold">@p.Title</td>
                            <td><span class="badge bg-light text-dark border">@categoryName</span></td>
                            <td class="fw-semibold">₹@p.Price.ToString("N0")</td>
                            <td>@sellerName</td>
                            <td>
                                <span class="badge rounded-pill fw-normal @(p.Status == ProductStatus.Available ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                    @p.Status
                                </span>
                            </td>
                            <td class="text-muted small">@p.CreatedAt.ToString("MMM dd")</td>
                            <td class="text-end">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-light rounded-pill px-3 me-1" style="font-size: 12px;">
                                    View
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" 
                                        data-bs-toggle="modal" data-bs-target="#adminDeleteModal-@p.Id" style="font-size: 12px;">
                                    Remove
                                </button>
                            </td>
                        </tr>

                        <!-- Admin Delete Modal -->
                        <div class="modal fade" id="adminDeleteModal-@p.Id" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 p-3 shadow">
                                    <div class="modal-body text-center py-4">
                                        <i class="bi bi-shield-x text-danger fs-1 mb-3"></i>
                                        <h4 class="fs-5 fw-semibold mb-2">Remove "@p.Title"?</h4>
                                        <p class="text-muted small mb-4">As an administrator, removing this listing will delete it and its images from the marketplace.</p>
                                        <div class="d-flex justify-content-center gap-2">
                                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                            <form asp-controller="Admin" asp-action="RemoveProduct" asp-route-id="@p.Id" method="post">
                                                <button type="submit" class="btn btn-danger rounded-pill px-4">Remove Listing</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
