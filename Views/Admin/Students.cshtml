@model List<ApplicationUser>
@{
    ViewData["Title"] = "Registered Students";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <nav style="font-size: 13px;" class="mb-1">
                <a asp-controller="Admin" asp-action="Index" class="apple-link">Admin Dashboard</a> / Students
            </nav>
            <h1 class="fs-3 fw-bold mb-0">Manage Registered Students</h1>
        </div>
        <span class="badge rounded-pill bg-light text-dark border px-3 py-2">
            Total Students: @Model.Count
        </span>
    </div>

    <div class="apple-form-card p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                <thead class="table-light">
                    <tr>
                        <th>Student Name</th>
                        <th>College Email</th>
                        <th>Phone</th>
                        <th>Branch</th>
                        <th>Semester</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.FullName</td>
                            <td>@s.Email</td>
                            <td>@s.PhoneNumber</td>
                            <td>@s.Branch</td>
                            <td>Sem @s.Semester</td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success fw-normal">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger-subtle text-danger fw-normal">Deactivated</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-controller="Admin" asp-action="StudentDetails" asp-route-id="@s.Id" class="btn btn-sm btn-light rounded-pill px-3" style="font-size: 12px;">
                                        View Profile
                                    </a>
                                    <form asp-controller="Admin" asp-action="ToggleStudentStatus" asp-route-id="@s.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm @(s.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-3" style="font-size: 12px;">
                                            @(s.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
