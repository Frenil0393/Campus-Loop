<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusLoop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Apple Minimalist Frosted Navigation -->
    <header class="apple-nav">
        <div class="container h-100 d-flex align-items-center justify-content-between">
            <a class="d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
                <i class="bi bi-circle-square text-dark fs-5"></i>
                <span class="fw-semibold text-dark fs-6" style="letter-spacing: -0.5px;">CampusLoop</span>
            </a>

            <nav class="d-none d-md-flex align-items-center gap-3">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Marketplace</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" asp-controller="Products" asp-action="MyProducts">My Listings</a>
                    <a class="nav-link" asp-controller="Checkout" asp-action="MyPurchases">My Purchases</a>
                    <a class="nav-link" asp-controller="Wishlist" asp-action="Index">Wishlist</a>
                    <a class="nav-link" asp-controller="Chat" asp-action="Index">Messages</a>
                    @if (User.IsInRole(Roles.Admin))
                    {
                        <a class="nav-link text-primary fw-semibold" asp-controller="Admin" asp-action="Index">Admin Portal</a>
                    }
                }
            </nav>

            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Products" asp-action="Create" class="btn-apple-primary text-decoration-none" style="padding: 6px 14px; font-size: 13px;">
                        <i class="bi bi-plus-lg"></i> Post Item
                    </a>

                    <div class="dropdown ms-1">
                        <button class="btn btn-sm btn-light rounded-pill border-0 px-3 py-1 dropdown-toggle text-dark" style="font-size: 13px;" type="button" data-bs-toggle="dropdown">
                            @User.Identity?.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2 rounded-4 p-2" style="font-size: 14px; min-width: 180px;">
                            <li><a class="dropdown-item py-2 rounded-3" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2 text-muted"></i>Profile</a></li>
                            <li><a class="dropdown-item py-2 rounded-3" asp-controller="Products" asp-action="MyProducts"><i class="bi bi-box-seam me-2 text-muted"></i>My Listings</a></li>
                            <li><a class="dropdown-item py-2 rounded-3" asp-controller="Checkout" asp-action="MyPurchases"><i class="bi bi-bag-check me-2 text-muted"></i>My Purchases</a></li>
                            <li><a class="dropdown-item py-2 rounded-3" asp-controller="Wishlist" asp-action="Index"><i class="bi bi-heart me-2 text-muted"></i>Wishlist</a></li>
                            <li><a class="dropdown-item py-2 rounded-3" asp-controller="Chat" asp-action="Index"><i class="bi bi-chat me-2 text-muted"></i>Messages</a></li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item py-2 rounded-3 text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="nav-link px-2" style="font-size: 13px;">Sign In</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-apple-primary text-decoration-none" style="padding: 5px 14px; font-size: 13px;">Register</a>
                }
            </div>
        </div>
    </header>

    <!-- Global Notifications -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center" style="background-color: #eaf5ea; color: #1e6424;" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div style="font-size: 15px;">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center" style="background-color: #fde8e8; color: #9b1c1c;" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div style="font-size: 15px;">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Apple Minimalist Footer -->
    <footer class="py-5 mt-5 border-top" style="background-color: var(--apple-parchment); font-size: 12px; color: var(--apple-muted);">
        <div class="container">
            <div class="row gy-3">
                <div class="col-md-6">
                    <p class="mb-1 fw-semibold text-dark">CampusLoop Academic Marketplace</p>
                    <p class="mb-0">Designed exclusively for campus students to buy and sell used academic gear directly.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none me-3">Marketplace</a>
                    <a asp-controller="Account" asp-action="Login" class="text-muted text-decoration-none me-3">Student Login</a>
                    <a asp-controller="Account" asp-action="Register" class="text-muted text-decoration-none">Register</a>
                </div>
            </div>
            <div class="mt-4 pt-3 border-top border-secondary-subtle d-flex justify-content-between">
                <span>&copy; 2026 CampusLoop Inc. All rights reserved.</span>
                <span>College Academic Project</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
