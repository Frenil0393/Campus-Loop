@model List<MarketplaceItemViewModel>
@{
    ViewData["Title"] = "My Saved Items";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="fs-3 fw-bold mb-1">Saved Wishlist</h1>
            <p class="text-muted mb-0" style="font-size: 15px;">Keep track of items you are interested in buying.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="apple-link">
            <i class="bi bi-arrow-left me-1"></i> Continue Browsing
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="apple-card h-100 position-relative">
                        <!-- Remove button -->
                        <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="position-absolute top-0 end-0 m-3" style="z-index: 5;">
                            <input type="hidden" name="productId" value="@item.Id" />
                            <input type="hidden" name="returnUrl" value="/Wishlist" />
                            <button type="submit" class="btn btn-sm btn-light rounded-circle shadow-sm border" style="width: 32px; height: 32px; padding: 0;" title="Remove from Wishlist">
                                <i class="bi bi-x-lg text-muted"></i>
                            </button>
                        </form>

                        <div class="apple-card-img-wrap">
                            <img src="@item.PrimaryImageUrl" class="apple-card-img" alt="@item.Title" />
                        </div>

                        <div class="d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-uppercase" style="font-size: 11px; font-weight: 600; color: var(--apple-muted);">@item.CategoryName</span>
                                <span class="badge rounded-pill fw-normal" style="font-size: 11px; @(item.Status == ProductStatus.Available ? "background: #eaf5ea; color: #1e6424;" : "background: #fde8e8; color: #9b1c1c;")">
                                    @item.Status
                                </span>
                            </div>

                            <h3 class="fs-6 fw-semibold text-dark text-truncate mb-2" title="@item.Title">@item.Title</h3>
                            <div class="fs-5 fw-bold text-dark mb-3">₹@item.Price.ToString("N0")</div>

                            <div class="mt-auto pt-2 border-top d-flex gap-2">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn-apple-outline flex-grow-1 justify-content-center" style="font-size: 13px; padding: 5px 12px;">
                                    View Item
                                </a>
                                @if (item.Status == ProductStatus.Available)
                                {
                                    <a asp-controller="Chat" asp-action="StartChat" asp-route-productId="@item.Id" class="btn-apple-primary px-3" style="font-size: 13px; padding: 5px 12px;" title="Chat with Seller">
                                        <i class="bi bi-chat"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 my-5">
            <i class="bi bi-heart fs-1 text-muted"></i>
            <h3 class="mt-3 fs-5 fw-semibold">Your wishlist is empty</h3>
            <p class="text-muted" style="font-size: 15px;">Browse the marketplace and tap the heart icon to save products here.</p>
            <a asp-controller="Home" asp-action="Index" class="btn-apple-primary mt-2">
                Explore Marketplace
            </a>
        </div>
    }
</div>
