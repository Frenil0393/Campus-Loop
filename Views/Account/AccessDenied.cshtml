@{
    ViewData["Title"] = "Access Denied";
}

<div class="container my-5 text-center py-5">
    <div class="p-5 rounded-4 mx-auto" style="max-width: 500px; background-color: var(--apple-parchment);">
        <i class="bi bi-shield-lock text-danger fs-1 mb-3 d-block"></i>
        <h2 class="fs-4 fw-semibold mb-2">Access Denied</h2>
        <p class="text-muted mb-4" style="font-size: 15px;">
            You do not have administrative authorization to access this area.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn-apple-primary">
            Return to Marketplace
        </a>
    </div>
</div>
