@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="apple-form-card">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <span class="text-uppercase" style="font-size: 11px; font-weight: 600; color: var(--apple-muted); letter-spacing: 0.5px;">Student Account</span>
                        <h2 class="fs-3 fw-semibold mb-0">@Model.FullName</h2>
                    </div>
                    <a asp-controller="Account" asp-action="EditProfile" class="btn-apple-outline" style="font-size: 13px; padding: 6px 16px;">
                        <i class="bi bi-pencil me-1"></i> Edit Profile
                    </a>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-sm-6">
                        <div class="p-3 rounded-4" style="background-color: var(--apple-parchment);">
                            <div class="text-muted" style="font-size: 12px;">College Email</div>
                            <div class="fw-semibold text-dark fs-6 text-truncate">@Model.Email</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-4" style="background-color: var(--apple-parchment);">
                            <div class="text-muted" style="font-size: 12px;">Phone Number</div>
                            <div class="fw-semibold text-dark fs-6">@Model.PhoneNumber</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-4" style="background-color: var(--apple-parchment);">
                            <div class="text-muted" style="font-size: 12px;">Branch / Department</div>
                            <div class="fw-semibold text-dark fs-6">@Model.Branch</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-4" style="background-color: var(--apple-parchment);">
                            <div class="text-muted" style="font-size: 12px;">Current Semester</div>
                            <div class="fw-semibold text-dark fs-6">Semester @Model.Semester</div>
                        </div>
                    </div>
                </div>

                <!-- Activity Statistics -->
                <div class="border-top pt-4">
                    <h4 class="fs-6 fw-semibold text-muted text-uppercase mb-3" style="letter-spacing: 0.5px;">Marketplace Activity</h4>
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="apple-metric-tile">
                                <div class="apple-metric-number">@Model.TotalListed</div>
                                <div class="apple-metric-label">Total Items Listed</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="apple-metric-tile">
                                <div class="apple-metric-number text-success">@Model.TotalSold</div>
                                <div class="apple-metric-label">Items Sold</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-between">
                    <a asp-controller="Products" asp-action="MyProducts" class="apple-link">
                        <i class="bi bi-box-seam me-1"></i> Manage My Product Listings
                    </a>
                    <span class="text-muted" style="font-size: 13px;">Member since @Model.MemberSince.ToString("MMMM yyyy")</span>
                </div>
            </div>
        </div>
    </div>
</div>
