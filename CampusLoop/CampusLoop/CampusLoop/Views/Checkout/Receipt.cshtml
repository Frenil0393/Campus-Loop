@model OrderReceiptViewModel
@{
    ViewData["Title"] = "Order Confirmation & Receipt";
}

<div class="container my-5" style="max-width: 780px;">
    <!-- Success Banner -->
    <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm" style="width: 72px; height: 72px; background-color: #eaf5ea; color: #1e6424;">
            <i class="bi bi-check-lg fs-1"></i>
        </div>
        <h1 class="fw-bold fs-2 mb-2" style="letter-spacing: -0.02em;">Payment Successful!</h1>
        <p class="text-muted" style="font-size: 16px;">
            Your order has been confirmed and the item has been marked as <strong>SOLD</strong>.
        </p>
        <span class="badge rounded-pill bg-light text-dark border px-3 py-2 fw-medium" style="font-size: 14px;">
            Transaction ID: <span class="text-primary font-monospace">@Model.TransactionId</span>
        </span>
    </div>

    <!-- Apple-styled Printable Receipt Card -->
    <div class="apple-card p-4 p-md-5 mb-4 shadow-sm" id="printableReceipt">
        <div class="d-flex justify-content-between align-items-center pb-4 mb-4 border-bottom">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 fw-bold text-dark" style="letter-spacing: -0.03em;">Campus<span style="color: var(--apple-primary);">Loop</span></span>
                <span class="badge rounded-pill bg-light text-muted border" style="font-size: 11px;">DDU Student Exchange</span>
            </div>
            <div class="text-end text-muted" style="font-size: 13px;">
                <div>@Model.PurchasedAt.ToString("MMMM dd, yyyy")</div>
                <div>@Model.PurchasedAt.ToString("hh:mm tt UTC")</div>
            </div>
        </div>

        <!-- Item summary -->
        <div class="row align-items-center mb-4 g-3">
            <div class="col-auto">
                <img src="@Model.ImageUrl" alt="@Model.ProductTitle" class="rounded-3 border object-fit-cover" style="width: 84px; height: 84px;" />
            </div>
            <div class="col">
                <span class="badge rounded-pill px-2 py-0 mb-1 fw-normal" style="background: rgba(0, 102, 204, 0.08); color: var(--apple-primary); font-size: 11px;">
                    Academic Item
                </span>
                <h3 class="fs-5 fw-bold text-dark mb-1">@Model.ProductTitle</h3>
                <div class="text-muted" style="font-size: 14px;">Payment Method: <span class="fw-medium text-dark">@Model.PaymentMethod</span></div>
            </div>
            <div class="col-auto text-end">
                <span class="fs-4 fw-bold text-dark">₹@Model.Amount.ToString("N0")</span>
            </div>
        </div>

        <!-- Campus Handover & Seller Contact Box -->
        <div class="p-3 rounded-4 mb-4" style="background-color: var(--apple-parchment);">
            <h4 class="fs-6 fw-bold text-dark mb-3">Campus Handover Details</h4>
            
            <div class="row g-3" style="font-size: 14px;">
                <div class="col-sm-6">
                    <span class="text-muted d-block" style="font-size: 12px; text-transform: uppercase;">Handover Spot</span>
                    <strong class="text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.PickupLocation</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block" style="font-size: 12px; text-transform: uppercase;">Seller Name</span>
                    <strong class="text-dark"><i class="bi bi-person-fill text-primary me-1"></i>@Model.SellerName</strong>
                </div>
                @if (!string.IsNullOrEmpty(Model.SellerPhone))
                {
                    <div class="col-sm-6">
                        <span class="text-muted d-block" style="font-size: 12px; text-transform: uppercase;">Seller Phone / WhatsApp</span>
                        <a href="tel:@Model.SellerPhone" class="text-decoration-none fw-medium text-primary">
                            <i class="bi bi-telephone-fill me-1"></i>@Model.SellerPhone
                        </a>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.SellerEmail))
                {
                    <div class="col-sm-6">
                        <span class="text-muted d-block" style="font-size: 12px; text-transform: uppercase;">Seller DDU Email</span>
                        <a href="mailto:@Model.SellerEmail" class="text-decoration-none fw-medium text-primary">
                            <i class="bi bi-envelope-fill me-1"></i>@Model.SellerEmail
                        </a>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="col-12">
                        <span class="text-muted d-block" style="font-size: 12px; text-transform: uppercase;">Your Handover Note</span>
                        <span class="text-dark fst-italic">"@Model.Notes"</span>
                    </div>
                }
            </div>
        </div>

        <!-- Payment Settlement Status -->
        <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="font-size: 14px;">
            <span class="text-muted">Total Paid</span>
            <span class="fs-4 fw-bold text-dark">₹@Model.Amount.ToString("N0")</span>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <button onclick="window.print()" class="btn-apple-outline py-2 px-4">
            <i class="bi bi-printer me-2"></i> Print Receipt
        </button>
        <a asp-controller="Checkout" asp-action="MyPurchases" class="btn-apple-secondary py-2 px-4">
            <i class="bi bi-bag-check me-2"></i> My Purchases
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn-apple-primary py-2 px-4">
            Explore More Gear
        </a>
    </div>
</div>
