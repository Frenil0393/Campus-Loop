@model CheckoutViewModel
@{
    ViewData["Title"] = "Direct Buy Checkout";
}

<div class="container my-5" style="max-width: 1040px;">
    <!-- Breadcrumb -->
    <nav class="mb-4" style="font-size: 13px;">
        <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">Marketplace</a>
        <span class="mx-2 text-muted">/</span>
        <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="text-muted text-decoration-none">@Model.ProductTitle</a>
        <span class="mx-2 text-muted">/</span>
        <span class="text-dark fw-semibold">Instant Checkout</span>
    </nav>

    <div class="mb-4">
        <span class="badge rounded-pill px-3 py-1 mb-2 fw-normal" style="background: rgba(0, 102, 204, 0.08); color: var(--apple-primary); font-size: 13px;">
            Secure Campus Handover
        </span>
        <h1 class="fw-bold fs-2 mb-1" style="letter-spacing: -0.02em;">Instant Buy & Checkout</h1>
        <p class="text-muted" style="font-size: 16px;">
            Complete your order and arrange seamless on-campus handover with your fellow student.
        </p>
    </div>

    <form asp-controller="Checkout" asp-action="ProcessPayment" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProductId" />
        <input type="hidden" asp-for="ProductTitle" />
        <input type="hidden" asp-for="Price" />
        <input type="hidden" asp-for="SellerId" />
        <input type="hidden" asp-for="ImageUrl" />

        <div class="row g-4">
            <!-- Left Column: Handover & Payment Options -->
            <div class="col-lg-7">
                <!-- Step 1: Handover Location -->
                <div class="apple-card mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; font-size: 13px;">1</span>
                        <h2 class="fs-5 fw-bold mb-0">DDU Campus Handover Spot</h2>
                    </div>
                    <p class="text-muted mb-3" style="font-size: 14px;">
                        Select an official campus rendezvous location for collecting your item.
                    </p>

                    <div class="mb-3">
                        <label asp-for="PickupLocation" class="form-label fw-semibold text-dark" style="font-size: 14px;">Pickup Location</label>
                        <select asp-for="PickupLocation" class="form-select apple-input" required>
                            <option value="DDU Central Library Foyer">Central Library Foyer (Quiet & Secure)</option>
                            <option value="Main Canteen / Food Court">Main Canteen / Campus Food Court</option>
                            <option value="Faculty of Technology (FOT) Lobby">Faculty of Technology (FOT) Lobby</option>
                            <option value="Computer Engineering Dept Entrance">Computer Engineering Dept Entrance</option>
                            <option value="Mechanical Workshop Quadrangle">Mechanical Workshop Quadrangle</option>
                            <option value="Boys Hostel Gate">Boys Hostel Gate</option>
                            <option value="Girls Hostel Gate">Girls Hostel Gate</option>
                        </select>
                        <span asp-validation-for="PickupLocation" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Notes" class="form-label fw-semibold text-dark" style="font-size: 14px;">Handover Note for Seller (Optional)</label>
                        <textarea asp-for="Notes" class="form-control apple-input" rows="2" placeholder="e.g. Free between 2 PM - 3 PM after labs"></textarea>
                        <span asp-validation-for="Notes" class="text-danger" style="font-size: 12px;"></span>
                    </div>
                </div>

                <!-- Step 2: Payment Method -->
                <div class="apple-card mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; font-size: 13px;">2</span>
                        <h2 class="fs-5 fw-bold mb-0">Payment Method</h2>
                    </div>
                    <p class="text-muted mb-3" style="font-size: 14px;">
                        Select your preferred verified payment method.
                    </p>

                    <!-- Payment Mode Selection Tabs -->
                    <div class="d-flex gap-2 p-1 rounded-pill bg-light border mb-4" role="tablist">
                        <label class="flex-grow-1 text-center py-2 px-3 rounded-pill cursor-pointer payment-tab active" style="font-size: 14px; font-weight: 500; cursor: pointer;">
                            <input type="radio" asp-for="PaymentMethod" value="@PaymentMethod.UPI" checked class="d-none" onchange="switchPaymentTab('upi')" />
                            <i class="bi bi-qr-code-scan me-1"></i> UPI / QR
                        </label>
                        <label class="flex-grow-1 text-center py-2 px-3 rounded-pill cursor-pointer payment-tab" style="font-size: 14px; font-weight: 500; cursor: pointer;">
                            <input type="radio" asp-for="PaymentMethod" value="@PaymentMethod.Card" class="d-none" onchange="switchPaymentTab('card')" />
                            <i class="bi bi-credit-card me-1"></i> Debit / Card
                        </label>
                        <label class="flex-grow-1 text-center py-2 px-3 rounded-pill cursor-pointer payment-tab" style="font-size: 14px; font-weight: 500; cursor: pointer;">
                            <input type="radio" asp-for="PaymentMethod" value="@PaymentMethod.NetBanking" class="d-none" onchange="switchPaymentTab('netbanking')" />
                            <i class="bi bi-bank me-1"></i> NetBanking
                        </label>
                        <label class="flex-grow-1 text-center py-2 px-3 rounded-pill cursor-pointer payment-tab" style="font-size: 14px; font-weight: 500; cursor: pointer;">
                            <input type="radio" asp-for="PaymentMethod" value="@PaymentMethod.CashOnHandover" class="d-none" onchange="switchPaymentTab('cash')" />
                            <i class="bi bi-cash-coin me-1"></i> Cash Handover
                        </label>
                    </div>

                    <!-- UPI Panel -->
                    <div id="panel-upi" class="payment-panel">
                        <div class="p-3 rounded-4 mb-3 border bg-light">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-semibold text-dark" style="font-size: 14px;">Instant UPI Transfer</span>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-white text-dark border px-2 py-1">GPay</span>
                                    <span class="badge bg-white text-dark border px-2 py-1">PhonePe</span>
                                    <span class="badge bg-white text-dark border px-2 py-1">Paytm</span>
                                </div>
                            </div>
                            <p class="text-muted mb-3" style="font-size: 13px;">
                                Enter your UPI ID or mobile number to simulate instant verification.
                            </p>
                            <div class="input-group mb-2">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-at"></i></span>
                                <input asp-for="UpiId" class="form-control apple-input border-start-0" placeholder="student@okhdfcbank or 9876543210@upi" value="@(User.Identity?.Name?.Split('@')[0])@@ddu.ac.in" />
                            </div>
                        </div>
                    </div>

                    <!-- Card Panel -->
                    <div id="panel-card" class="payment-panel d-none">
                        <div class="p-3 rounded-4 mb-3 border bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-semibold text-dark" style="font-size: 14px;">Card Details</span>
                                <div class="d-flex gap-1">
                                    <i class="bi bi-credit-card-2-front fs-5 text-primary"></i>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted" style="font-size: 12px;">CARD NUMBER</label>
                                <input asp-for="CardNumber" class="form-control apple-input" placeholder="4242 •••• •••• 4242" value="4532 8901 2345 6789" />
                            </div>
                            <div class="row g-2">
                                <div class="col-7">
                                    <label class="form-label text-muted" style="font-size: 12px;">VALID THRU</label>
                                    <input asp-for="CardExpiry" class="form-control apple-input" placeholder="MM/YY" value="12/28" />
                                </div>
                                <div class="col-5">
                                    <label class="form-label text-muted" style="font-size: 12px;">CVV</label>
                                    <input asp-for="CardCvv" type="password" maxlength="4" class="form-control apple-input" placeholder="•••" value="888" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- NetBanking Panel -->
                    <div id="panel-netbanking" class="payment-panel d-none">
                        <div class="p-3 rounded-4 mb-3 border bg-light">
                            <span class="fw-semibold text-dark d-block mb-2" style="font-size: 14px;">Popular Campus Banks</span>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="p-2 border rounded-3 bg-white text-center cursor-pointer hover-shadow" style="font-size: 13px;">
                                        State Bank of India
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 border rounded-3 bg-white text-center cursor-pointer hover-shadow" style="font-size: 13px;">
                                        HDFC Bank
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 border rounded-3 bg-white text-center cursor-pointer hover-shadow" style="font-size: 13px;">
                                        ICICI Bank
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 border rounded-3 bg-white text-center cursor-pointer hover-shadow" style="font-size: 13px;">
                                        Bank of Baroda
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cash Panel -->
                    <div id="panel-cash" class="payment-panel d-none">
                        <div class="p-3 rounded-4 mb-3 border bg-light">
                            <div class="d-flex align-items-center gap-2 text-dark mb-1">
                                <i class="bi bi-cash-stack fs-5 text-success"></i>
                                <span class="fw-semibold" style="font-size: 14px;">Pay in Cash at Pickup</span>
                            </div>
                            <p class="text-muted mb-0" style="font-size: 13px;">
                                Pay ₹@Model.Price.ToString("N0") in exact change directly to @Model.SellerName when verifying the item on campus.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 13px;">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span>CampusLoop Escrow Protection & Student Identity Verification Active.</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Order Summary & Pay CTA -->
            <div class="col-lg-5">
                <div class="apple-card position-sticky" style="top: 80px;">
                    <h2 class="fs-5 fw-bold mb-3 pb-2 border-bottom">Order Summary</h2>

                    <!-- Product Item Detail -->
                    <div class="d-flex gap-3 mb-4">
                        <img src="@Model.ImageUrl" alt="@Model.ProductTitle" class="rounded-3 border object-fit-cover shadow-sm" style="width: 80px; height: 80px;" />
                        <div class="overflow-hidden">
                            <span class="badge rounded-pill px-2 py-0 mb-1 fw-normal text-uppercase" style="background: rgba(0,0,0,0.06); color: var(--apple-muted); font-size: 10px;">
                                @Model.CategoryName
                            </span>
                            <h3 class="fs-6 fw-bold text-dark text-truncate mb-1">@Model.ProductTitle</h3>
                            <div class="text-muted" style="font-size: 13px;">
                                Seller: <span class="text-dark fw-medium">@Model.SellerName</span>
                            </div>
                        </div>
                    </div>

                    <!-- Price Calculations -->
                    <div class="py-2 border-top border-bottom mb-3" style="font-size: 14px;">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Item Subtotal</span>
                            <span class="fw-semibold text-dark">₹@Model.Price.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">DDU Campus Delivery</span>
                            <span class="text-success fw-medium">FREE (Self Handover)</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Platform Service Fee</span>
                            <span class="text-success fw-medium">₹0.00</span>
                        </div>
                    </div>

                    <!-- Total -->
                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fs-5 fw-bold text-dark">Total Amount</span>
                        <span class="fs-3 fw-bold text-primary">₹@Model.Price.ToString("N0")</span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-apple-primary w-100 justify-content-center py-3 fs-6 mb-3">
                        <i class="bi bi-lock-fill me-2"></i> Pay & Confirm Order ₹@Model.Price.ToString("N0")
                    </button>

                    <div class="text-center text-muted" style="font-size: 12px;">
                        By clicking "Pay & Confirm Order", you agree to CampusLoop student terms and commit to completing the on-campus exchange.
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function switchPaymentTab(type) {
            // Update active tab styles
            document.querySelectorAll('.payment-tab').forEach(el => {
                el.classList.remove('active', 'bg-white', 'shadow-sm', 'text-primary');
            });
            event.currentTarget.classList.add('active', 'bg-white', 'shadow-sm', 'text-primary');

            // Hide all panels
            document.querySelectorAll('.payment-panel').forEach(el => el.classList.add('d-none'));

            // Show selected panel
            const targetPanel = document.getElementById('panel-' + type);
            if (targetPanel) {
                targetPanel.classList.remove('d-none');
            }
        }
    </script>
}
