@model List<MarketplaceItemViewModel>
@{
    ViewData["Title"] = "Campus Marketplace";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    int? currentCategory = ViewBag.CurrentCategory as int?;
    string? currentSearch = ViewBag.CurrentSearch as string;
    string? currentSort = ViewBag.CurrentSort as string;
}

<div class="container my-4">
    <!-- Apple Hero Tile -->
    <div class="apple-hero-tile">
        <span class="badge rounded-pill px-3 py-1 mb-3 fw-normal" style="background: rgba(0,0,0,0.06); color: var(--apple-ink); font-size: 13px;">
            Student-to-Student Marketplace
        </span>
        <h1 class="apple-hero-title">Academic gear. Recirculated.</h1>
        <p class="apple-hero-sub">
            Buy and sell verified calculators, drafting tools, laptops, textbooks, and campus essentials directly with fellow students.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a asp-controller="Products" asp-action="Create" class="btn-apple-primary">
                Post an Item to Sell
            </a>
            <a asp-controller="Wishlist" asp-action="Index" class="btn-apple-secondary">
                View Saved Items
            </a>
        </div>
    </div>

    <!-- Apple Filter Bar -->
    <div class="mb-4">
        <form method="get" asp-controller="Home" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" name="search" class="form-control apple-input ps-5" placeholder="Search products by title or description..." value="@currentSearch" />
                </div>
            </div>

            <div class="col-md-3">
                <select name="categoryId" class="form-select apple-input" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        if (currentCategory == cat.Id)
                        {
                            <option value="@cat.Id" selected="selected">@cat.Name</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="sort" class="form-select apple-input" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(currentSort))">Newest First</option>
                    <option value="price_asc" selected="@(currentSort == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(currentSort == "price_desc")">Price: High to Low</option>
                    <option value="oldest" selected="@(currentSort == "oldest")">Oldest First</option>
                </select>
            </div>

            <div class="col-md-1">
                <a asp-controller="Home" asp-action="Index" class="btn btn-light rounded-pill w-100 p-2 text-muted" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>

        <!-- Category Horizontal Pills -->
        <div class="d-flex gap-2 overflow-x-auto py-3">
            <a asp-controller="Home" asp-action="Index" class="apple-pill @(currentCategory == null ? "active" : "")">All</a>
            @foreach (var cat in categories)
            {
                <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@cat.Id" class="apple-pill @(currentCategory == cat.Id ? "active" : "")">
                    @cat.Name
                </a>
            }
        </div>
    </div>

    <!-- Photography-First Product Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="apple-card h-100">
                        <!-- Wishlist Toggle Button -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="position-absolute top-0 end-0 m-3" style="z-index: 5;">
                                <input type="hidden" name="productId" value="@item.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="btn btn-sm btn-light rounded-circle shadow-sm border" style="width: 34px; height: 34px; padding: 0;" title="Save to Wishlist">
                                    <i class="bi @(item.IsInWishlist ? "bi-heart-fill text-danger" : "bi-heart text-muted")"></i>
                                </button>
                            </form>
                        }

                        <!-- Photography Frame -->
                        <div class="apple-card-img-wrap">
                            <img src="@item.PrimaryImageUrl" class="apple-card-img" alt="@item.Title" loading="lazy" />
                        </div>

                        <!-- Card Body -->
                        <div class="d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-uppercase" style="font-size: 11px; font-weight: 600; color: var(--apple-muted); letter-spacing: 0.5px;">@item.CategoryName</span>
                                <span class="badge rounded-pill fw-normal" style="font-size: 11px; @(item.Status == ProductStatus.Available ? "background: #eaf5ea; color: #1e6424;" : "background: #fde8e8; color: #9b1c1c;")">
                                    @item.Status
                                </span>
                            </div>

                            <h3 class="fs-6 fw-semibold text-dark text-truncate mb-2" title="@item.Title">@item.Title</h3>

                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fs-5 fw-bold text-dark">₹@item.Price.ToString("N0")</span>
                                </div>
                                <div class="d-flex gap-1">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn-apple-outline" style="padding: 5px 11px; font-size: 13px;">
                                        Details
                                    </a>
                                    @if (item.Status == ProductStatus.Available)
                                    {
                                        <a asp-controller="Checkout" asp-action="Index" asp-route-id="@item.Id" class="btn-apple-primary" style="padding: 5px 13px; font-size: 13px;">
                                            Buy
                                        </a>
                                    }
                                </div>
                            </div>

                            <div class="mt-2 text-muted d-flex justify-content-between" style="font-size: 12px;">
                                <span><i class="bi bi-person me-1"></i>@item.SellerName</span>
                                <span>@item.CreatedAt.ToString("MMM dd")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 py-5 text-center">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <h3 class="mt-3 fs-5 fw-semibold">No products found</h3>
                <p class="text-muted" style="font-size: 15px;">Try adjusting your search keyword or browse all categories.</p>
                <a asp-controller="Home" asp-action="Index" class="btn-apple-secondary">Reset Filters</a>
            </div>
        }
    </div>
</div>
