@model List<Category>
@{
    ViewData["Title"] = "Manage Categories";
    var productCounts = ViewBag.ProductCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <nav style="font-size: 13px;" class="mb-1">
                <a asp-controller="Admin" asp-action="Index" class="apple-link">Admin Dashboard</a> / Categories
            </nav>
            <h1 class="fs-3 fw-bold mb-0">Marketplace Categories</h1>
        </div>
        <button type="button" class="btn-apple-primary" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
            <i class="bi bi-plus-lg"></i> Add New Category
        </button>
    </div>

    <div class="apple-form-card p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                <thead class="table-light">
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Active Products</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        var count = productCounts.ContainsKey(cat.Id) ? productCounts[cat.Id] : 0;
                        <tr>
                            <td class="fw-semibold">@cat.Name</td>
                            <td class="text-muted small">@cat.Description</td>
                            <td>
                                <span class="badge rounded-pill bg-light text-dark border">
                                    @count product(s)
                                </span>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-light rounded-pill px-3 me-1" 
                                        data-bs-toggle="modal" data-bs-target="#editModal-@cat.Id" style="font-size: 12px;">
                                    Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" 
                                        data-bs-toggle="modal" data-bs-target="#deleteModal-@cat.Id" style="font-size: 12px;">
                                    Delete
                                </button>
                            </td>
                        </tr>

                        <!-- Edit Category Modal -->
                        <div class="modal fade" id="editModal-@cat.Id" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 p-3 shadow">
                                    <form asp-controller="Admin" asp-action="EditCategory" method="post">
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <div class="modal-header border-0 pb-0">
                                            <h5 class="modal-title fs-5 fw-semibold">Edit Category</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body py-3">
                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold">Category Name</label>
                                                <input type="text" name="name" class="form-control apple-input" value="@cat.Name" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold">Description</label>
                                                <textarea name="description" class="form-control apple-input" rows="3">@cat.Description</textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0 pt-0">
                                            <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn-apple-primary px-4">Save</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Delete Category Modal -->
                        <div class="modal fade" id="deleteModal-@cat.Id" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 p-3 shadow">
                                    <div class="modal-body text-center py-4">
                                        <i class="bi bi-exclamation-triangle text-danger fs-1 mb-3"></i>
                                        <h4 class="fs-5 fw-semibold mb-2">Delete "@cat.Name"?</h4>
                                        @if (count > 0)
                                        {
                                            <p class="text-danger small mb-4">Warning: @count product(s) are listed under this category. Reassign or delete the products first.</p>
                                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                                        }
                                        else
                                        {
                                            <p class="text-muted small mb-4">This category will be permanently removed.</p>
                                            <div class="d-flex justify-content-center gap-2">
                                                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-controller="Admin" asp-action="DeleteCategory" asp-route-id="@cat.Id" method="post">
                                                    <button type="submit" class="btn btn-danger rounded-pill px-4">Delete Category</button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 p-3 shadow">
            <form asp-controller="Admin" asp-action="AddCategory" method="post">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fs-5 fw-semibold">Add New Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Category Name</label>
                        <input type="text" name="name" class="form-control apple-input" placeholder="e.g. Lab Kits & Equipment" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea name="description" class="form-control apple-input" rows="3" placeholder="Brief summary of items in this category..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-apple-primary px-4">Add Category</button>
                </div>
            </form>
        </div>
    </div>
</div>
