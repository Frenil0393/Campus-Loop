@model ApplicationUser
@{
    ViewData["Title"] = "Student Details: " + Model.FullName;
    var listings = ViewBag.Listings as List<Product> ?? new List<Product>();
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <nav style="font-size: 13px;" class="mb-1">
                <a asp-controller="Admin" asp-action="Index" class="apple-link">Admin Dashboard</a> / 
                <a asp-controller="Admin" asp-action="Students" class="apple-link">Students</a> / 
                Details
            </nav>
            <h1 class="fs-3 fw-bold mb-0">@Model.FullName</h1>
        </div>
        <div>
            <form asp-controller="Admin" asp-action="ToggleStudentStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-4" style="font-size: 13px;">
                    @(Model.IsActive ? "Deactivate Account" : "Reactivate Account")
                </button>
            </form>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="apple-form-card p-4">
                <h3 class="fs-6 fw-semibold text-muted text-uppercase mb-3">Profile Data</h3>
                <div class="mb-3">
                    <div class="text-muted small">College Email</div>
                    <div class="fw-semibold">@Model.Email</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Phone Number</div>
                    <div class="fw-semibold">@Model.PhoneNumber</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Branch</div>
                    <div class="fw-semibold">@Model.Branch</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Semester</div>
                    <div class="fw-semibold">Semester @Model.Semester</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Account Status</div>
                    <div>
                        <span class="badge rounded-pill fw-normal @(Model.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                            @(Model.IsActive ? "Active" : "Deactivated")
                        </span>
                    </div>
                </div>
                <div>
                    <div class="text-muted small">Joined</div>
                    <div class="fw-semibold">@Model.CreatedAt.ToString("MMMM dd, yyyy")</div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="apple-form-card p-4">
                <h3 class="fs-6 fw-semibold text-muted text-uppercase mb-3">Items Posted by this Student (@listings.Count)</h3>
                @if (listings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th class="text-end">View</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in listings)
                                {
                                    <tr>
                                        <td class="fw-semibold">@p.Title</td>
                                        <td>₹@p.Price.ToString("N0")</td>
                                        <td>
                                            <span class="badge rounded-pill fw-normal @(p.Status == ProductStatus.Available ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                                @p.Status
                                            </span>
                                        </td>
                                        <td class="text-muted">@p.CreatedAt.ToString("MMM dd")</td>
                                        <td class="text-end">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-light rounded-pill px-3">
                                                Inspect
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">This student has not posted any products yet.</p>
                }
            </div>
        </div>
    </div>
</div>
