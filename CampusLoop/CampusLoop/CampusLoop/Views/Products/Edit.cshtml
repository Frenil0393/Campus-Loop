@model ProductEditViewModel
@{
    ViewData["Title"] = "Edit Listing";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="apple-form-card">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h2 class="fs-4 fw-semibold mb-0">Edit Product Listing</h2>
                        <span class="text-muted small">Update details or photos for this item</span>
                    </div>
                    <a asp-controller="Products" asp-action="MyProducts" class="apple-link" style="font-size: 14px;">Cancel</a>
                </div>

                <form asp-controller="Products" asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 py-2 border-0 mb-3" style="font-size: 14px;"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold" style="font-size: 13px;">Item Title</label>
                        <input asp-for="Title" class="form-control apple-input" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold" style="font-size: 13px;">Category</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select apple-input"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold" style="font-size: 13px;">Asking Price (₹)</label>
                            <input asp-for="Price" class="form-control apple-input" type="number" step="10" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold" style="font-size: 13px;">Description</label>
                        <textarea asp-for="Description" class="form-control apple-input" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Current Photos -->
                    @if (Model.ExistingImageUrls != null && Model.ExistingImageUrls.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold" style="font-size: 13px;">Current Photos</label>
                            <div class="d-flex gap-2 flex-wrap">
                                @foreach (var img in Model.ExistingImageUrls)
                                {
                                    <div class="rounded-3 overflow-hidden border" style="width: 80px; height: 60px;">
                                        <img src="@img" class="w-100 h-100 object-fit-cover" alt="Product photo" />
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Upload Replacement Photos -->
                    <div class="mb-4 p-3 rounded-4" style="background-color: var(--apple-parchment);">
                        <label asp-for="NewImageFiles" class="form-label fw-semibold" style="font-size: 13px;">
                            Replace Images (Optional - Upload 3 to 4 photos to replace existing ones)
                        </label>
                        <input asp-for="NewImageFiles" class="form-control apple-input bg-white" type="file" multiple accept="image/*" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-apple-primary w-100 justify-content-center py-2">
                            Save Changes
                        </button>
                        <a asp-controller="Products" asp-action="MyProducts" class="btn-apple-secondary w-50 justify-content-center py-2">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
