@model EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="apple-form-card">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <h2 class="fs-4 fw-semibold mb-0">Update Profile</h2>
                    <a asp-controller="Account" asp-action="Profile" class="apple-link" style="font-size: 14px;">Cancel</a>
                </div>

                <form asp-controller="Account" asp-action="EditProfile" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 py-2 border-0 mb-3" style="font-size: 14px;"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold" style="font-size: 13px;">Full Name</label>
                        <input asp-for="FullName" class="form-control apple-input" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold" style="font-size: 13px;">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control apple-input" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Branch" class="form-label fw-semibold" style="font-size: 13px;">Branch / Department</label>
                            <input asp-for="Branch" class="form-control apple-input" />
                            <span asp-validation-for="Branch" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Semester" class="form-label fw-semibold" style="font-size: 13px;">Semester</label>
                            <select asp-for="Semester" class="form-select apple-input">
                                @for (int i = 1; i <= 8; i++)
                                {
                                    <option value="@i">Semester @i</option>
                                }
                            </select>
                            <span asp-validation-for="Semester" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4 pt-2 border-top">
                        <label asp-for="NewPassword" class="form-label fw-semibold" style="font-size: 13px;">New Password (Optional)</label>
                        <input asp-for="NewPassword" class="form-control apple-input" placeholder="Leave blank to keep current password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-apple-primary w-100 justify-content-center py-2">
                            Save Changes
                        </button>
                        <a asp-controller="Account" asp-action="Profile" class="btn-apple-secondary w-50 justify-content-center py-2">
                            Cancel
                        </a>
                    </div>
                </form>

                <!-- Delete Account Option (R.1.6) -->
                <div class="mt-5 pt-4 border-top">
                    <h5 class="fs-6 fw-semibold text-danger mb-1">Delete Account</h5>
                    <p class="text-muted small mb-3">Permanently deactivate your CampusLoop account and end your active sessions.</p>
                    <button type="button" class="btn btn-outline-danger rounded-pill px-3 py-1 btn-sm" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                        Delete My Account
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 p-3 shadow">
            <div class="modal-body text-center py-4">
                <i class="bi bi-exclamation-triangle text-danger fs-1 mb-3"></i>
                <h4 class="fs-5 fw-semibold mb-2">Are you sure you want to delete your account?</h4>
                <p class="text-muted small mb-4">This will deactivate your access to CampusLoop. This action cannot be undone.</p>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Account" asp-action="DeleteAccount" method="post">
                        <button type="submit" class="btn btn-danger rounded-pill px-4">Yes, Delete Account</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
