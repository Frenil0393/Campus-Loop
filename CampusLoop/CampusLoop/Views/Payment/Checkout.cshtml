@model CampusLoop.Models.Product
@{
    ViewData["Title"] = "Campus Checkout - " + Model.Name;
    var primaryImage = Model.ImageUrls.FirstOrDefault() ?? "https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=800";
    var sanitizedSellerName = Model.Seller?.FullName.Replace(" ", "").ToLower() ?? "seller";
    var sellerUpi = $"{sanitizedSellerName}@okddu";
    var qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=upi://pay?pa={sellerUpi}%26pn={Uri.EscapeDataString(Model.Seller?.FullName ?? "Seller")}%26am={Model.Price}%26cu=INR";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
                <div>
                    <h3 class="fw-bold mb-1"><i class="bi bi-shield-check text-success me-2"></i>Campus Safe Checkout</h3>
                    <p class="text-muted small mb-0">Direct student-to-student exchange with verified 4-Digit Handshake OTP</p>
                </div>
                <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Back to Product
                </a>
            </div>

            <div class="row g-4">
                <!-- Left: Order Item Summary -->
                <div class="col-md-5">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                        <h6 class="fw-bold text-muted text-uppercase fs-8 mb-3">Item Summary</h6>
                        <div class="d-flex gap-3 align-items-center mb-3">
                            <img src="@primaryImage" alt="@Model.Name" class="rounded-3 border object-fit-cover" width="80" height="80" />
                            <div>
                                <span class="badge bg-primary-subtle text-primary fs-9 mb-1">@(Model.Category?.Name ?? "College Item")</span>
                                <h6 class="fw-bold text-dark mb-1">@Model.Name</h6>
                                <span class="badge bg-light text-muted border fs-9">Condition: @Model.Condition</span>
                            </div>
                        </div>

                        <hr class="text-muted my-3" />

                        <!-- Price Breakdown -->
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Item Agreed Price</span>
                            <span class="fw-bold">₹@Model.Price.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Campus Marketplace Fee</span>
                            <span class="badge bg-success-subtle text-success">₹0 (Free)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 small">
                            <span class="text-muted">Handshake OTP Guarantee</span>
                            <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Included</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-light border">
                            <span class="fw-bold fs-6">Total Amount:</span>
                            <span class="display-6 fw-extrabold text-primary fs-4">₹@Model.Price.ToString("N0")</span>
                        </div>

                        <!-- Seller Info -->
                        <div class="mt-4 p-3 rounded-3 bg-light border small">
                            <h6 class="fw-bold text-dark fs-8 text-uppercase mb-2"><i class="bi bi-person-fill text-primary me-1"></i> Student Seller</h6>
                            <div class="fw-semibold">@Model.Seller?.FullName</div>
                            <div class="text-muted">@Model.Seller?.Branch &bull; @Model.Seller?.Semester</div>
                            <div class="text-muted mt-1"><i class="bi bi-telephone me-1"></i> @Model.Seller?.PhoneNumber</div>
                            <div class="text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Meeting: <strong>@Model.CampusLocation</strong></div>
                        </div>
                    </div>
                </div>

                <!-- Right: Payment Methods Form -->
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <h5 class="fw-bold mb-3">Choose Payment Method</h5>

                        <form asp-controller="Payment" asp-action="ProcessCheckout" method="post" id="checkoutForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.Id" />

                            <!-- Payment Options Tabs/Radios -->
                            <div class="d-flex flex-column gap-3 mb-4">
                                <!-- 1. UPI QR Code Option -->
                                <label class="payment-method-card p-3 rounded-3 border cursor-pointer d-flex align-items-start gap-3">
                                    <input type="radio" name="paymentMethod" value="UpiQr" class="form-check-input mt-1" checked onchange="togglePaymentSection('upi')" />
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold text-dark"><i class="bi bi-qr-code text-primary me-2"></i> UPI QR Code (Instant Scan & Pay)</span>
                                            <span class="badge bg-success-subtle text-success">Recommended</span>
                                        </div>
                                        <p class="text-muted small mb-0 mt-1">Scan via Google Pay, PhonePe, Paytm, or BHIM</p>
                                    </div>
                                </label>

                                <!-- 2. Cash on Handover Option -->
                                <label class="payment-method-card p-3 rounded-3 border cursor-pointer d-flex align-items-start gap-3">
                                    <input type="radio" name="paymentMethod" value="CashOnHandover" class="form-check-input mt-1" onchange="togglePaymentSection('cash')" />
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold text-dark"><i class="bi bi-cash-stack text-success me-2"></i> Cash on Physical Handover</span>
                                            <span class="badge bg-secondary-subtle text-secondary">Traditional</span>
                                        </div>
                                        <p class="text-muted small mb-0 mt-1">Pay physical cash to seller when meeting on campus after checking the item</p>
                                    </div>
                                </label>

                                <!-- 3. Debit / Credit Card Option -->
                                <label class="payment-method-card p-3 rounded-3 border cursor-pointer d-flex align-items-start gap-3">
                                    <input type="radio" name="paymentMethod" value="Card" class="form-check-input mt-1" onchange="togglePaymentSection('card')" />
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold text-dark"><i class="bi bi-credit-card-2-front-fill text-warning me-2"></i> Debit / Credit Card</span>
                                            <span class="text-muted fs-8">Visa / RuPay / MC</span>
                                        </div>
                                        <p class="text-muted small mb-0 mt-1">Pay securely via any bank debit or credit card</p>
                                    </div>
                                </label>
                            </div>

                            <!-- Dynamic Details Sections -->
                            <!-- UPI Box -->
                            <div id="upiDetailsBox" class="p-3 rounded-3 bg-light border mb-4 text-center">
                                <h6 class="fw-bold text-dark mb-2">Scan & Pay to Seller's UPI</h6>
                                <div class="p-2 bg-white d-inline-block rounded-3 border shadow-xs mb-2">
                                    <img src="@qrUrl" alt="UPI QR" width="180" height="180" class="img-fluid" />
                                </div>
                                <div class="small fw-semibold text-primary">UPI ID: @sellerUpi</div>
                                <div class="fs-8 text-muted mt-1">Amount: ₹@Model.Price.ToString("N0") &bull; Merchant: CampusLoop Dharmsinh Desai University (DDU)</div>
                            </div>

                            <!-- Cash Box -->
                            <div id="cashDetailsBox" class="p-3 rounded-3 bg-success-subtle border border-success-subtle mb-4" style="display: none;">
                                <h6 class="fw-bold text-success mb-2"><i class="bi bi-geo-alt-fill me-1"></i> Campus Meeting & Handover Details</h6>
                                <p class="small text-muted mb-2">
                                    You will meet <strong>@Model.Seller?.FullName</strong> at <strong>@Model.CampusLocation</strong>.
                                    When you confirm this order, you will receive a <strong>4-Digit Handshake OTP</strong>. 
                                    Show this OTP to the seller after inspecting the item and handing over ₹@Model.Price.ToString("N0") cash.
                                </p>
                            </div>

                            <!-- Card Box -->
                            <div id="cardDetailsBox" class="p-3 rounded-3 bg-light border mb-4" style="display: none;">
                                <h6 class="fw-bold text-dark mb-3">Card Payment Details</h6>
                                <div class="mb-2">
                                    <label class="form-label fs-8 text-muted fw-semibold">Card Number</label>
                                    <input type="text" class="form-control form-control-sm" placeholder="4532 &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 8921" maxlength="19" />
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label fs-8 text-muted fw-semibold">Expiry Date</label>
                                        <input type="text" class="form-control form-control-sm" placeholder="MM/YY" maxlength="5" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label fs-8 text-muted fw-semibold">CVV</label>
                                        <input type="password" class="form-control form-control-sm" placeholder="&bull;&bull;&bull;" maxlength="4" />
                                    </div>
                                </div>
                            </div>

                            <!-- Buyer Meeting Note -->
                            <div class="mb-4">
                                <label class="form-label small fw-semibold text-dark">Meeting Note for Seller (Optional)</label>
                                <textarea name="buyerNotes" class="form-control" rows="2" placeholder="e.g. Can meet near Library entrance during 1:00 PM lunch break"></textarea>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold shadow-xs py-3">
                                <i class="bi bi-shield-lock-fill me-2"></i> Confirm Order & Generate Handshake OTP
                            </button>

                            <div class="text-center mt-3 fs-8 text-muted">
                                <i class="bi bi-lock-fill me-1"></i> Verified college transaction &bull; Zero commission peer-to-peer deal
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePaymentSection(type) {
            document.getElementById('upiDetailsBox').style.display = (type === 'upi') ? 'block' : 'none';
            document.getElementById('cashDetailsBox').style.display = (type === 'cash') ? 'block' : 'none';
            document.getElementById('cardDetailsBox').style.display = (type === 'card') ? 'block' : 'none';
        }
    </script>
}
