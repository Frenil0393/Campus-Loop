@model IEnumerable<CampusLoop.Models.PaymentOrder>
@{
    ViewData["Title"] = "My Campus Orders & Transactions";
}

<div class="container my-5">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-bag-check-fill text-primary me-2"></i>Campus Orders & Handshake OTPs</h3>
            <p class="text-muted small mb-0">Track your purchases, verified meeting spots, and 4-digit handover codes</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill btn-sm">
            <i class="bi bi-shop me-1"></i> Browse Marketplace
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-muted mx-auto mb-3" style="width: 70px; height: 70px;">
                <i class="bi bi-bag-x fs-2"></i>
            </div>
            <h5 class="fw-bold text-dark">No Orders Yet</h5>
            <p class="text-muted small">You haven't purchased or booked any items yet.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 mx-auto">
                Explore Student Items
            </a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light fs-8 text-uppercase text-muted">
                        <tr>
                            <th class="ps-4">Order ID & Date</th>
                            <th>Item Name</th>
                            <th>Amount</th>
                            <th>Payment Mode</th>
                            <th>Handshake OTP</th>
                            <th>Meeting Spot</th>
                            <th>Seller</th>
                            <th class="text-end pe-4">Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="font-monospace fw-bold fs-8 text-primary">@order.OrderId</div>
                                    <div class="text-muted fs-9">@order.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                                </td>
                                <td>
                                    <strong class="text-dark">@order.ProductName</strong>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">₹@order.Amount.ToString("N0")</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border fs-9">@order.Method</span>
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark font-monospace fs-7 px-2 py-1">
                                        <i class="bi bi-key-fill me-1"></i>@order.HandshakeOtp
                                    </span>
                                </td>
                                <td>
                                    <span class="small text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@order.CampusMeetingSpot</span>
                                </td>
                                <td>
                                    <span class="small text-muted">@order.SellerName</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-controller="Payment" asp-action="Success" asp-route-orderId="@order.OrderId" class="btn btn-sm btn-outline-secondary rounded-pill">
                                        <i class="bi bi-receipt"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
