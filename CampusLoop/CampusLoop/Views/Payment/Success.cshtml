@model CampusLoop.Models.PaymentOrder
@{
    ViewData["Title"] = "Order Confirmed - " + Model.OrderId;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center">
                <!-- Success Icon -->
                <div class="mb-3 d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success mx-auto" style="width: 80px; height: 80px;">
                    <i class="bi bi-check-circle-fill display-4"></i>
                </div>

                <span class="badge bg-success-subtle text-success fw-semibold px-3 py-1 rounded-pill mx-auto mb-2">
                    Verified Campus Deal
                </span>

                <h2 class="fw-extrabold text-dark mb-1">Booking Confirmed!</h2>
                <p class="text-muted mb-4">
                    Your request for <strong>@Model.ProductName</strong> has been securely logged on CampusLoop.
                </p>

                <!-- Handshake OTP Box -->
                <div class="p-4 rounded-4 bg-primary text-white mb-4 shadow-sm">
                    <div class="fs-8 text-uppercase tracking-wider fw-bold text-white-50 mb-1">
                        Physical Exchange Handshake OTP
                    </div>
                    <div class="display-3 fw-extrabold letter-spacing-2 my-2 text-warning">
                        @Model.HandshakeOtp
                    </div>
                    <p class="small text-white-50 mb-0">
                        <i class="bi bi-info-circle me-1"></i> Give this 4-digit code to the seller <strong>@Model.SellerName</strong> when you physically inspect and receive the item.
                    </p>
                </div>

                <!-- Meeting & Receipt Card -->
                <div class="text-start bg-light rounded-4 p-4 border mb-4">
                    <h6 class="fw-bold text-dark fs-8 text-uppercase mb-3 border-bottom pb-2">
                        <i class="bi bi-receipt me-1 text-primary"></i> Exchange Receipt & Details
                    </h6>

                    <div class="row g-3 small">
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Order Reference:</span>
                            <strong class="text-dark font-monospace">@Model.OrderId</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Transaction ID:</span>
                            <strong class="text-dark font-monospace">@Model.TransactionReference</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Item Name:</span>
                            <strong class="text-dark">@Model.ProductName</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Amount Payable:</span>
                            <strong class="text-primary fs-6">₹@Model.Amount.ToString("N0")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Payment Mode:</span>
                            <span class="badge bg-dark text-white">@Model.Method.ToString()</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Handover Meeting Spot:</span>
                            <strong class="text-danger"><i class="bi bi-geo-alt-fill me-1"></i>@Model.CampusMeetingSpot</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Student Seller:</span>
                            <strong class="text-dark">@Model.SellerName</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Seller UPI ID:</span>
                            <strong class="text-muted">@Model.SellerUpiId</strong>
                        </div>
                    </div>
                </div>

                <!-- Navigation Actions -->
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i> Print / Save Receipt
                    </button>
                    <a asp-controller="Payment" asp-action="Orders" class="btn btn-outline-primary rounded-pill px-4">
                        <i class="bi bi-card-checklist me-1"></i> My Orders & OTPs
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-shop me-1"></i> Return to Marketplace
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
