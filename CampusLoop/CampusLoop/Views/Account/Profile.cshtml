@model CampusLoop.Models.StudentUser
@{
    ViewData["Title"] = "Student Profile (R.1.4)";
}

<div class="container my-5">
    <div class="row g-4">
        <!-- Left: Profile Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    <img src="@Model.AvatarUrl" class="rounded-circle border border-3 border-primary p-1 shadow-sm" width="100" height="100" alt="@Model.FullName" />
                    <span class="position-absolute bottom-0 end-0 p-2 bg-success border border-white rounded-circle" title="Active Account"></span>
                </div>
                <h5 class="fw-bold text-dark mb-0">@Model.FullName</h5>
                <span class="badge bg-primary-subtle text-primary mt-1">@Model.Role Account</span>

                <div class="p-3 bg-light rounded-3 text-start mt-4 small">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Student ID:</span>
                        <span class="fw-bold font-monospace">@Model.Id</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Status:</span>
                        <span class="badge bg-success">Active Verified</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Member Since:</span>
                        <span>@Model.CreatedAt.ToString("MMM yyyy")</span>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="button" class="btn btn-outline-primary rounded-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                        <i class="bi bi-pencil-square me-1"></i> Update Profile (R.1.5)
                    </button>
                    <button type="button" class="btn btn-outline-danger rounded-3 btn-sm" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                        <i class="bi bi-trash me-1"></i> Delete Account (R.1.6)
                    </button>
                </div>
            </div>
        </div>

        <!-- Right: Academic & Contact Details (R.1.4) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold mb-4 pb-2 border-bottom">
                    <i class="bi bi-mortarboard text-primary me-2"></i>Academic & Contact Details (R.1.4)
                </h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small">Full Name</label>
                        <div class="fw-bold text-dark fs-6">@Model.FullName</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">College Email Address</label>
                        <div class="fw-bold text-dark fs-6">@Model.CollegeEmail</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Phone Number</label>
                        <div class="fw-bold text-dark fs-6">@Model.PhoneNumber</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Engineering Branch</label>
                        <div class="fw-bold text-dark fs-6">@Model.Branch</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Current Semester</label>
                        <div class="fw-bold text-dark fs-6">@Model.Semester</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Active Listings</label>
                        <div class="fw-bold text-primary fs-6">@(Model.Products?.Count ?? 0) Items Listed</div>
                    </div>
                </div>
            </div>

            <!-- Recent Products Posted by Student -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-box-seam text-primary me-2"></i>My Posted Products (R.3.2)</h6>
                    <a asp-controller="Product" asp-action="MyProducts" class="btn btn-sm btn-outline-primary rounded-pill">View All Listings</a>
                </div>

                @if (Model.Products != null && Model.Products.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var p in Model.Products.Take(4))
                        {
                            <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(p.ImageUrls.FirstOrDefault() ?? "https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=100")" class="rounded-3" width="45" height="45" style="object-fit: cover;">
                                    <div>
                                        <div class="fw-bold text-dark">@p.Name</div>
                                        <span class="badge @(p.Status == "AVAILABLE" ? "bg-success" : "bg-secondary")">@p.Status</span>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-extrabold text-primary">₹@p.Price.ToString("N0")</div>
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="small text-decoration-none">Details &rarr;</a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">You have not posted any products yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- UPDATE PROFILE MODAL (R.1.5) -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mb-0">Update Profile (R.1.5)</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 pt-2">
                <form asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Full Name</label>
                        <input type="text" name="fullName" class="form-control" value="@Model.FullName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Phone Number</label>
                        <input type="tel" name="phoneNumber" class="form-control" value="@Model.PhoneNumber" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Branch</label>
                        <input type="text" name="branch" class="form-control" value="@Model.Branch" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Semester</label>
                        <input type="text" name="semester" class="form-control" value="@Model.Semester" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">New Password (Leave blank to keep current)</label>
                        <input type="password" name="newPassword" class="form-control" placeholder="••••••••" />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-bold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- DELETE ACCOUNT CONFIRMATION MODAL (R.1.6) -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold text-danger mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Account (R.1.6)</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 pt-2">
                <p class="text-muted">
                    Are you sure you want to delete your CampusLoop student account? 
                    This will permanently remove your profile, user data, and all products you have listed in the marketplace.
                </p>
                <form asp-action="DeleteAccount" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold">Confirm Account Deletion</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
