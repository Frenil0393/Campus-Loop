@{
    ViewData["Title"] = "Student & Admin Login";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- Navigation back to Home Page -->
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill fw-semibold shadow-xs">
                    <i class="bi bi-house-door-fill me-1"></i> Back to Home Page
                </a>
                <span class="small text-muted">DDU Marketplace</span>
            </div>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-gradient-primary text-white text-center p-4 border-0">
                    <div class="brand-icon-wrapper mx-auto mb-2">
                        <i class="bi bi-person-lock text-white fs-4"></i>
                    </div>
                    <h4 class="fw-bold mb-1">CampusLoop Login</h4>
                    <p class="small text-white-50 mb-0">Dharmsinh Desai University (DDU) Student Portal</p>
                </div>
                <div class="card-body p-4 p-lg-5">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger rounded-3 small mb-3">
                            <i class="bi bi-exclamation-circle-fill me-1"></i> @ViewBag.Error
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">College Email Address (DDU)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                <input type="email" name="email" id="loginEmail" class="form-control" placeholder="e.g. 24ceuos155@ddu.ac.in" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
                                <input type="password" name="password" id="loginPassword" class="form-control" placeholder="••••••••" required />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-bold shadow-xs mb-3">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to CampusLoop
                        </button>
                    </form>

                    <!-- Quick Demo Credentials Filler (for effortless testing) -->
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <span class="fs-9 text-uppercase text-muted fw-bold d-block mb-2 text-center">Quick Demo Credentials (1-Click Fill)</span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-success flex-grow-1" onclick="fillDemoStudent()">
                                <i class="bi bi-person-check me-1"></i> Student (24ceuos155)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-dark flex-grow-1" onclick="fillDemoAdmin()">
                                <i class="bi bi-shield-lock me-1"></i> Admin Login
                            </button>
                        </div>
                    </div>

                    <div class="text-center small text-muted">
                        Don't have an account yet? 
                        <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Register as Student</a>
                    </div>

                    <!-- Direct Home Page Button -->
                    <div class="mt-4 pt-3 border-top text-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light w-100 rounded-pill fw-semibold border shadow-xs text-secondary py-2">
                            <i class="bi bi-house-door-fill me-1 text-primary"></i> Browse Home Page (Marketplace)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillDemoStudent() {
            document.getElementById('loginEmail').value = '24ceuos155@ddu.ac.in';
            document.getElementById('loginPassword').value = 'Student@123';
        }
        function fillDemoAdmin() {
            document.getElementById('loginEmail').value = 'admin@ddu.ac.in';
            document.getElementById('loginPassword').value = 'Admin@123';
        }
    </script>
}
