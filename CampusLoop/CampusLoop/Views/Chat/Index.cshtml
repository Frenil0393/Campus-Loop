@{
    ViewData["Title"] = "Campus Messages & Chats (R.6)";
    var conversations = ViewBag.Conversations as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-chat-dots-fill text-primary me-2"></i>Campus Messages & Inquiries</h3>
            <p class="text-muted small mb-0">Private negotiations and meet-up discussions for college items</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Marketplace
        </a>
    </div>

    @if (conversations.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="list-group list-group-flush">
                @foreach (var c in conversations)
                {
                    <a asp-action="Conversation" asp-route-productId="@c.ProductId" asp-route-sellerId="@c.Partner?.Id" 
                       class="list-group-item list-group-item-action p-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3 overflow-hidden">
                            <img src="@(c.Partner?.AvatarUrl ?? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100")" 
                                 class="rounded-circle border flex-shrink-0" width="48" height="48" alt="@c.Partner?.FullName" />
                            <div class="overflow-hidden">
                                <div class="d-flex align-items-center gap-2">
                                    <h6 class="fw-bold mb-0 text-dark text-truncate">@c.Partner?.FullName</h6>
                                    <span class="badge bg-light text-muted border fs-9">@c.Partner?.Branch</span>
                                </div>
                                <div class="small fw-semibold text-primary text-truncate">
                                    Regarding: @c.Product?.Name
                                </div>
                                <p class="text-muted small text-truncate mb-0">@c.LatestMessage</p>
                            </div>
                        </div>
                        <div class="text-end flex-shrink-0 ms-3">
                            <div class="fs-8 text-muted mb-1">@c.LatestTime.ToString("hh:mm tt")</div>
                            @if (c.UnreadCount > 0)
                            {
                                <span class="badge bg-primary rounded-pill">@c.UnreadCount new</span>
                            }
                        </div>
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="empty-icon-wrapper mx-auto mb-3">
                <i class="bi bi-chat-square-text text-muted fs-1"></i>
            </div>
            <h5 class="fw-bold">No Active Conversations</h5>
            <p class="text-muted small max-w-400 mx-auto">
                When you click "Chat with Seller" on any marketplace listing, your negotiations and message history will appear here.
            </p>
            <div class="mt-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    Explore Marketplace Products
                </a>
            </div>
        </div>
    }
</div>
