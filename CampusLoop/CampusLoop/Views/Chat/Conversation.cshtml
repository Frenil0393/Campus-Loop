@model List<CampusLoop.Models.DbChatMessage>
@{
    var product = ViewBag.Product as CampusLoop.Models.Product;
    var partner = ViewBag.Partner as CampusLoop.Models.StudentUser;
    var currentUserId = ViewBag.CurrentUserId as string;
    ViewData["Title"] = "Chat: " + (product?.Name ?? "Item");
    var prodImg = product?.ImageUrls.FirstOrDefault() ?? "https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=100";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- 1. Header: Chat Partner Info -->
                <div class="card-header bg-gradient-primary text-white p-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <a asp-action="Index" class="text-white text-decoration-none me-1" title="Back to Inbox">
                            <i class="bi bi-arrow-left fs-5"></i>
                        </a>
                        <div class="position-relative">
                            <img src="@(partner?.AvatarUrl ?? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100")" 
                                 class="rounded-circle border border-white" width="44" height="44" alt="@partner?.FullName" />
                            <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-white rounded-circle"></span>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-white">@partner?.FullName</h6>
                            <span class="fs-8 text-white-50">@partner?.Branch &bull; @partner?.Semester</span>
                        </div>
                    </div>
                    <span class="badge bg-white bg-opacity-25 text-white">
                        <i class="bi bi-broadcast me-1"></i> SignalR Live
                    </span>
                </div>

                <!-- 2. Product Information Banner in Chat (R.6.5) -->
                @if (product != null)
                {
                    <div class="p-2 px-3 bg-light border-bottom d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3 overflow-hidden">
                            <img src="@prodImg" class="rounded-3 border flex-shrink-0" width="48" height="48" style="object-fit: cover;" alt="@product.Name" />
                            <div class="overflow-hidden">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="fw-bold fs-7 text-dark text-decoration-none text-truncate d-block">
                                    @product.Name
                                </a>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-extrabold text-primary fs-7">₹@product.Price.ToString("N0")</span>
                                    <span class="badge @(product.Status == "AVAILABLE" ? "bg-success-subtle text-success" : "bg-secondary") fs-9">
                                        @product.Status
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Direct Buy & Pay Button in Chat -->
                        @if (product.Status == "AVAILABLE")
                        {
                            <a asp-controller="Payment" asp-action="Checkout" asp-route-productId="@product.Id"
                               class="btn btn-sm btn-success rounded-pill fw-bold text-nowrap px-3 shadow-xs text-decoration-none">
                                <i class="bi bi-lightning-charge-fill me-1"></i> Pay Now (₹@product.Price.ToString("N0"))
                            </a>
                        }
                    </div>
                }

                <!-- 3. Chat Messages Stream Window (R.6.4: History & R.6.3: Real-time SignalR) -->
                <div class="card-body p-4 chat-messages-container" id="chatMessageArea" style="height: 420px; overflow-y: auto; background-color: #f8fafc;">
                    <div class="text-center text-muted small my-2 fs-9">
                        <i class="bi bi-lock-fill me-1"></i> Private negotiation between buyer and seller. Physical exchange on campus.
                    </div>

                    @foreach (var msg in Model)
                    {
                        var isOwn = msg.SenderId == currentUserId;
                        <div class="chat-msg @(isOwn ? "sent align-items-end" : "received align-items-start") d-flex flex-column mb-3">
                            <div class="msg-bubble p-2 px-3 rounded-4 @(isOwn ? "bg-primary text-white" : "bg-white text-dark border") shadow-xs small">
                                @msg.MessageText
                            </div>
                            <span class="fs-9 text-muted mt-1 @(isOwn ? "me-2" : "ms-2")">
                                @msg.SentAt.ToString("hh:mm tt")
                                @if (isOwn)
                                {
                                    <i class="bi bi-check2-all text-primary ms-1"></i>
                                }
                            </span>
                        </div>
                    }
                </div>

                <!-- 4. Chat Input Form (R.6.2: Send Message via C# Backend) -->
                <div class="card-footer p-3 bg-white border-top">
                    <form asp-controller="Chat" asp-action="SendMessage" method="post" id="signalrChatForm" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@(product?.Id)" />
                        <input type="hidden" name="receiverId" value="@(partner?.Id)" />
                        <input type="text" name="messageText" id="signalrMsgInput" class="form-control rounded-pill border-light-subtle ps-3" 
                               placeholder="Type message or negotiate price..." autocomplete="off" required />
                        <button type="submit" class="btn btn-primary rounded-circle p-2 px-3 shadow-xs" title="Send Message">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const productId = @(product?.Id ?? 0);
        const partnerId = "@(partner?.Id ?? "")";
        const currentUserId = "@(currentUserId ?? "")";
        const chatArea = document.getElementById('chatMessageArea');

        // Scroll to bottom on load
        if (chatArea) chatArea.scrollTop = chatArea.scrollHeight;

        let isConnected = false;
        let connection = null;

        try {
            if (typeof signalR !== 'undefined') {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl("/chatHub")
                    .withAutomaticReconnect()
                    .build();

                connection.on("ReceiveMessage", function (data) {
                    const isOwn = (data.senderId === currentUserId);
                    const msgDiv = document.createElement('div');
                    msgDiv.className = `chat-msg ${isOwn ? 'sent align-items-end' : 'received align-items-start'} d-flex flex-column mb-3`;
                    msgDiv.innerHTML = `
                        <div class="msg-bubble p-2 px-3 rounded-4 ${isOwn ? 'bg-primary text-white' : 'bg-white text-dark border'} shadow-xs small">
                            ${escapeHtml(data.message)}
                        </div>
                        <span class="fs-9 text-muted mt-1 ${isOwn ? 'me-2' : 'ms-2'}">
                            ${data.sentAt} ${isOwn ? '<i class="bi bi-check2-all text-primary ms-1"></i>' : ''}
                        </span>
                    `;
                    chatArea.appendChild(msgDiv);
                    chatArea.scrollTop = chatArea.scrollHeight;
                });

                connection.start().then(function () {
                    isConnected = true;
                    connection.invoke("JoinChatRoom", productId, partnerId);
                }).catch(function (err) {
                    console.log("SignalR socket offline, using standard C# Backend form submission.");
                });
            }
        } catch (e) {
            console.log("Using standard C# Backend form submission.");
        }

        // R.6.2: Send message form
        document.getElementById('signalrChatForm').addEventListener('submit', function (e) {
            if (isConnected && connection) {
                e.preventDefault();
                const input = document.getElementById('signalrMsgInput');
                const message = input.value.trim();
                if (!message) return;

                connection.invoke("SendMessage", productId, partnerId, message)
                    .then(() => {
                        input.value = "";
                    })
                    .catch(() => {
                        document.getElementById('signalrChatForm').submit();
                    });
            }
            // If SignalR is not connected, the form natively submits POST to C# Backend ChatController.SendMessage!
        });

        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }
    </script>
}
