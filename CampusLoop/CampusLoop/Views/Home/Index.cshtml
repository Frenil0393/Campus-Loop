@model CampusLoop.Models.MarketplaceViewModel
@{
    ViewData["Title"] = "Marketplace";
}

<!-- Hero Section -->
<section class="hero-section py-5 text-white position-relative overflow-hidden mb-4">
    <div class="hero-background-glow"></div>
    <div class="container-fluid px-lg-5 position-relative">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-25 mb-3 backdrop-blur">
                    <span class="badge bg-warning text-dark fw-bold">NEW</span>
                    <span class="small">Semester Swap 2026: Clear unused books & instruments!</span>
                </div>
                <h1 class="display-5 fw-extrabold hero-heading mb-3">
                    Buy & Sell Used Items Inside Your <span class="text-warning text-highlight">College Campus</span>
                </h1>
                <p class="lead text-white-50 mb-4 max-w-650">
                    Trusted student-to-student marketplace. Discover scientific calculators, drafting kits, semester notes, textbooks, and hostel essentials at student-friendly prices with zero platform fee.
                </p>

                <!-- Hero Search Bar with Instant Suggestions -->
                <div class="hero-search-box p-2 bg-white rounded-4 shadow-lg d-flex flex-column flex-md-row gap-2 max-w-650">
                    <div class="input-group border-0 flex-grow-1">
                        <span class="input-group-text bg-transparent border-0 text-muted ps-3">
                            <i class="bi bi-search fs-5"></i>
                        </span>
                        <input type="text" id="heroSearchInput" class="form-control border-0 text-dark ps-2" placeholder="Search by name: 'Casio', 'Drafter', 'Balagurusamy'..." />
                    </div>
                    <button class="btn btn-primary px-4 py-2 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2" id="heroSearchBtn">
                        <span>Find Deals</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>

                <!-- Popular Tags -->
                <div class="d-flex flex-wrap align-items-center gap-2 mt-3 small">
                    <span class="text-white-50">Popular Searches:</span>
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill py-0 px-2 hero-tag" data-tag="Casio">Casio FX-991</button>
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill py-0 px-2 hero-tag" data-tag="Drafter">Mini Drafter</button>
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill py-0 px-2 hero-tag" data-tag="Textbooks">Semester Books</button>
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill py-0 px-2 hero-tag" data-tag="Table">Study Table</button>
                    <button type="button" class="btn btn-sm btn-outline-light rounded-pill py-0 px-2 hero-tag" data-tag="Arduino">Arduino Kit</button>
                </div>
            </div>

            <!-- Hero Highlights / Stats -->
            <div class="col-lg-5">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="stat-card p-3 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-20 backdrop-blur">
                            <div class="stat-icon bg-warning text-dark mb-2">
                                <i class="bi bi-bag-check-fill fs-4"></i>
                            </div>
                            <h3 class="fw-bold mb-0 text-white" id="statAvailableCount">@Model.TotalAvailableItems</h3>
                            <span class="small text-white-50">Available Items</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-card p-3 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-20 backdrop-blur">
                            <div class="stat-icon bg-info text-white mb-2">
                                <i class="bi bi-mortarboard-fill fs-4"></i>
                            </div>
                            <h3 class="fw-bold mb-0 text-white">480+</h3>
                            <span class="small text-white-50">Active Students</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-card p-3 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-20 backdrop-blur">
                            <div class="stat-icon bg-success text-white mb-2">
                                <i class="bi bi-shield-check fs-4"></i>
                            </div>
                            <h3 class="fw-bold mb-0 text-white">1,250+</h3>
                            <span class="small text-white-50">Verified Deals</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-card p-3 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-20 backdrop-blur">
                            <div class="stat-icon bg-danger text-white mb-2">
                                <i class="bi bi-currency-rupee fs-4"></i>
                            </div>
                            <h3 class="fw-bold mb-0 text-white">0%</h3>
                            <span class="small text-white-50">Platform Fee</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Marketplace Section -->
<section class="container-fluid px-lg-5 my-4" id="marketplace-section">
    <!-- Category Pills Navigation (R.4.2 & R.4.3) -->
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Explore Categories</h4>
            <p class="text-muted small mb-0">Browse student items grouped by academic and campus needs</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm rounded-pill" id="clearAllFiltersBtn" style="display: none;">
                <i class="bi bi-x-circle me-1"></i> Clear All Filters
            </button>
        </div>
    </div>

    <!-- Category Pills Row -->
    <div class="category-scroll-container pb-2 mb-4">
        <div class="d-flex gap-2 category-pills-row">
            @foreach (var cat in Model.Categories)
            {
                var isActive = (Model.SelectedCategory == cat.Slug) || (cat.Slug == "all" && string.IsNullOrEmpty(Model.SelectedCategory));
                <button type="button" 
                        class="btn category-pill-btn @(isActive ? "active" : "") d-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-xs"
                        data-category="@cat.Slug">
                    <i class="bi @cat.IconClass fs-6"></i>
                    <span class="fw-semibold">@cat.Name</span>
                    @if (cat.Slug != "all")
                    {
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill small">@cat.ItemCount</span>
                    }
                </button>
            }
        </div>
    </div>

    <!-- Search & Filter Controls Toolbar (R.4.1) -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <div class="row g-3 align-items-center">
            <!-- Keyword Search Input -->
            <div class="col-12 col-md-4 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0 text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="liveSearchInput" class="form-control bg-light border-0" 
                           placeholder="Type product name, author, or branch..." value="@Model.SearchKeyword" />
                    <button class="btn btn-light border-0 text-muted" type="button" id="clearSearchInputBtn" style="display: none;">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Price Range Filter Chips -->
            <div class="col-12 col-md-5 col-lg-4">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="small text-muted fw-semibold d-none d-xl-inline">Budget:</span>
                    <div class="btn-group btn-group-sm w-100-mobile" role="group" id="budgetFiltersGroup">
                        <button type="button" class="btn btn-outline-secondary active" data-min="0" data-max="99999">All</button>
                        <button type="button" class="btn btn-outline-secondary" data-min="0" data-max="300">Under ₹300</button>
                        <button type="button" class="btn btn-outline-secondary" data-min="300" data-max="800">₹300 - ₹800</button>
                        <button type="button" class="btn btn-outline-secondary" data-min="800" data-max="99999">₹800+</button>
                    </div>
                </div>
            </div>

            <!-- Sort By Dropdown -->
            <div class="col-12 col-md-3 col-lg-3 text-md-end">
                <div class="d-flex align-items-center justify-content-md-end gap-2">
                    <label for="sortDropdown" class="small text-muted fw-semibold text-nowrap">Sort:</label>
                    <select class="form-select form-select-sm border-light-subtle rounded-3 w-auto" id="sortDropdown">
                        <option value="newest" selected>Latest Listings</option>
                        <option value="price_asc">Price: Low to High</option>
                        <option value="price_desc">Price: High to Low</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Filter Status Bar -->
        <div class="d-flex align-items-center justify-content-between pt-3 mt-2 border-top small text-muted">
            <div>
                Showing <strong class="text-dark" id="visibleProductCount">@Model.Products.Count</strong> products available for purchase on campus
            </div>
            <div id="activeFilterTags" class="d-flex align-items-center gap-1">
                <!-- Dynamically injected active filter chips -->
            </div>
        </div>
    </div>

    <!-- Products Grid (R.2.1) -->
    <div class="row g-4" id="productsGrid">
        @foreach (var product in Model.Products)
        {
            var primaryImage = product.ImageUrls.FirstOrDefault() ?? "https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=500";
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 product-card-col" 
                 data-id="@product.Id"
                 data-name="@product.Name.ToLower()"
                 data-category="@product.Category?.Slug"
                 data-price="@product.Price"
                 data-condition="@product.Condition"
                 data-status="@product.Status">
                
                <div class="card h-100 border-0 shadow-sm product-card rounded-4 overflow-hidden position-relative">
                    <!-- Image Container with Hover Zoom & Badges -->
                    <div class="product-img-wrapper position-relative">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="d-block w-100 h-100">
                            <img src="@primaryImage" class="card-img-top product-img" alt="@product.Name" loading="lazy" />
                        </a>
                        
                        <!-- Status Badge (R.3.6) -->
                        <span class="badge @(product.Status == "AVAILABLE" ? "bg-success" : "bg-danger") position-absolute top-0 start-0 m-3 shadow-xs">
                            <i class="bi bi-check-circle-fill me-1"></i> @product.Status
                        </span>

                        <!-- Condition Pill -->
                        <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 start-0 m-3 backdrop-blur small">
                            @product.Condition
                        </span>

                        <!-- Wishlist Toggle Button -->
                        <button type="button" class="btn btn-white btn-sm rounded-circle position-absolute top-0 end-0 m-3 shadow-sm wishlist-btn" 
                                data-id="@product.Id" title="Add to Wishlist">
                            <i class="bi bi-heart text-muted"></i>
                        </button>

                        <!-- Quick View Link (R.2.2) -->
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" 
                           class="btn btn-light btn-sm rounded-pill position-absolute top-50 start-50 translate-middle shadow quick-view-btn opacity-0 transition-all text-decoration-none">
                            <i class="bi bi-eye-fill me-1 text-primary"></i> View Details
                        </a>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body p-3 d-flex flex-column">
                        <!-- Category & Time -->
                        <div class="d-flex justify-content-between align-items-center mb-1 small">
                            <span class="badge bg-primary-subtle text-primary fw-semibold rounded-pill px-2 py-1">
                                @(product.Category?.Name ?? "General")
                            </span>
                            <span class="text-muted fs-8">
                                <i class="bi bi-clock me-1"></i>Today
                            </span>
                        </div>

                        <!-- Product Title (Direct Link to Details) -->
                        <h6 class="card-title fw-bold mb-1 product-title text-truncate-2">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none text-dark hover-primary" title="@product.Name">
                                @product.Name
                            </a>
                        </h6>

                        <!-- Location Tag -->
                        <div class="text-muted small mb-2 d-flex align-items-center text-truncate">
                            <i class="bi bi-geo-alt text-danger me-1 flex-shrink-0"></i>
                            <span class="text-truncate">@product.CampusLocation</span>
                        </div>

                        <!-- Price Section -->
                        <div class="d-flex align-items-baseline gap-2 mb-3 mt-auto">
                            <span class="fs-4 fw-extrabold text-dark product-price">₹@product.Price.ToString("N0")</span>
                            <span class="badge bg-light text-muted border small">Negotiable</span>
                        </div>

                        <!-- Seller Info Banner (R.7.1) -->
                        <div class="seller-banner p-2 rounded-3 bg-light d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                <img src="@(product.Seller?.AvatarUrl ?? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100")" 
                                     alt="@product.Seller?.FullName" class="rounded-circle flex-shrink-0" width="28" height="28">
                                <div class="text-truncate">
                                    <div class="fw-bold fs-8 text-dark text-truncate">@product.Seller?.FullName</div>
                                    <div class="text-muted fs-9 text-truncate">@product.Seller?.Branch (@product.Seller?.Semester)</div>
                                </div>
                            </div>
                            <span class="badge bg-success-subtle text-success p-1 rounded-circle flex-shrink-0" title="Verified Student">
                                <i class="bi bi-patch-check-fill"></i>
                            </span>
                        </div>

                        <!-- Direct C# Backend Action Buttons: Buy & Pay, Chat with Seller (R.6) & Details (R.2.2) -->
                        <div class="d-grid gap-2 pt-1 border-top mt-1">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <!-- 1. PAY: Direct C# Backend Checkout Link (Available when logged in) -->
                                <a asp-controller="Payment" asp-action="Checkout" asp-route-productId="@product.Id"
                                   class="btn btn-success btn-sm w-100 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-1 shadow-xs text-decoration-none">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                    <span>Buy & Pay ₹@product.Price.ToString("N0")</span>
                                </a>
                            }
                            else
                            {
                                <!-- Prompt to login before buying -->
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Checkout", "Payment", new { productId = product.Id })"
                                   class="btn btn-outline-success btn-sm w-100 rounded-3 fw-semibold d-flex align-items-center justify-content-center gap-1 shadow-xs text-decoration-none" title="Login to buy this item">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    <span>Login to Buy (₹@product.Price.ToString("N0"))</span>
                                </a>
                            }
                            <div class="d-flex gap-2">
                                <!-- 2. CHAT: Direct C# Backend Conversation Link -->
                                <a asp-controller="Chat" asp-action="Conversation" asp-route-productId="@product.Id" asp-route-sellerId="@product.SellerId"
                                   class="btn btn-outline-primary btn-sm flex-grow-1 rounded-3 fw-semibold d-flex align-items-center justify-content-center gap-1 text-decoration-none">
                                    <i class="bi bi-chat-dots-fill"></i>
                                    <span>Chat</span>
                                </a>
                                <!-- 3. VIEW: Direct C# Backend Product Details Link -->
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                                   class="btn btn-outline-secondary btn-sm px-3 rounded-3 text-decoration-none d-flex align-items-center justify-content-center" title="View Full Details & Photos">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Empty State for Search / Filters -->
    <div id="noProductsFound" class="card border-0 shadow-sm rounded-4 p-5 text-center my-4" style="display: none;">
        <div class="empty-icon-wrapper mx-auto mb-3">
            <i class="bi bi-search text-muted fs-1"></i>
        </div>
        <h5 class="fw-bold">No Products Found</h5>
        <p class="text-muted small max-w-400 mx-auto">
            We couldn't find any campus items matching your search or filter criteria. Try searching with fewer keywords or reset your filters.
        </p>
        <div class="mt-2">
            <button class="btn btn-primary rounded-pill px-4" id="resetEmptyStateBtn">
                <i class="bi bi-arrow-clockwise me-1"></i> Reset All Filters
            </button>
        </div>
    </div>
</section>

<!-- HOW CAMPUSLOOP WORKS BANNER -->
<section class="container-fluid px-lg-5 my-5">
    <div class="card border-0 bg-white shadow-sm rounded-4 p-4 p-lg-5">
        <div class="row g-4 text-center">
            <div class="col-12 text-center mb-2">
                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill mb-2">HOW IT WORKS</span>
                <h3 class="fw-bold">Safe & Simple Campus Exchange (R.15)</h3>
                <p class="text-muted small max-w-600 mx-auto">Designed specifically for on-campus student life. No shipping delays, no payment transaction deductions.</p>
            </div>
            
            <div class="col-md-3">
                <div class="step-card p-3">
                    <div class="step-number bg-primary text-white mx-auto mb-3">1</div>
                    <h6 class="fw-bold">List Pre-loved Items</h6>
                    <p class="small text-muted mb-0">Upload 3–4 photos, set your price, and describe the condition of your book, calculator, or gear.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="step-card p-3">
                    <div class="step-number bg-primary text-white mx-auto mb-3">2</div>
                    <h6 class="fw-bold">Search & Discover</h6>
                    <p class="small text-muted mb-0">Juniors or batchmates search by branch, subject, or keyword to find what they need for classes.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="step-card p-3">
                    <div class="step-number bg-primary text-white mx-auto mb-3">3</div>
                    <h6 class="fw-bold">Chat & Finalize (R.6)</h6>
                    <p class="small text-muted mb-0">Discuss questions and negotiate price safely inside the product chat room in real-time.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="step-card p-3">
                    <div class="step-number bg-success text-white mx-auto mb-3">4</div>
                    <h6 class="fw-bold">Handover & Mark Sold</h6>
                    <p class="small text-muted mb-0">Meet at the library or canteen, inspect the item, pay via Cash/UPI, and mark the item as SOLD.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================================================= -->
<!-- MODALS -->
<!-- ========================================================================= -->

<!-- 1. QUICK VIEW / PRODUCT DETAILS MODAL (R.2.2 & R.14.2) -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-labelledby="quickViewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header border-0 pb-0">
                <span class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1" id="modalCategoryBadge">Category</span>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 pt-2">
                <div class="row g-4">
                    <!-- Left: 3-4 Images Gallery (R.14.2) -->
                    <div class="col-md-6">
                        <div class="main-modal-img-wrapper rounded-3 overflow-hidden border mb-2 bg-light">
                            <img src="" id="modalMainImage" class="w-100 h-auto modal-main-img" alt="Product Image" />
                        </div>
                        <!-- Thumbnail Strip -->
                        <div class="d-flex gap-2 thumbnail-strip" id="modalThumbnailStrip">
                            <!-- Injected dynamically via JS -->
                        </div>
                    </div>

                    <!-- Right: Product Info & Seller Details (R.2.2 & R.7.1) -->
                    <div class="col-md-6 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="badge bg-success text-white" id="modalStatusBadge">AVAILABLE</span>
                            <span class="badge bg-dark bg-opacity-75 text-white" id="modalConditionBadge">Like New</span>
                        </div>
                        
                        <h4 class="fw-bold text-dark mb-2" id="modalProductName">Product Title</h4>
                        
                        <div class="d-flex align-items-baseline gap-2 mb-3">
                            <span class="display-6 fw-bold text-primary" id="modalProductPrice">₹0</span>
                            <span class="text-muted small">Fixed / Negotiable</span>
                        </div>

                        <div class="p-2 rounded-3 bg-light mb-3 small">
                            <div class="text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Meeting Point:</div>
                            <strong class="text-dark" id="modalCampusLocation">Library Lawn</strong>
                        </div>

                        <h6 class="fw-bold mb-1 small text-uppercase text-muted">Item Description</h6>
                        <p class="text-muted small mb-3 description-text" id="modalProductDescription">
                            Product description goes here...
                        </p>

                        <!-- Seller Profile Card (R.7.1) -->
                        <div class="seller-info-box p-3 rounded-3 border bg-white mt-auto mb-3">
                            <h6 class="fw-bold fs-8 text-uppercase text-muted mb-2"><i class="bi bi-person-badge me-1"></i> Seller Details (R.7.1)</h6>
                            <div class="d-flex align-items-center gap-3">
                                <img src="" id="modalSellerAvatar" class="rounded-circle border" width="45" height="45" alt="Seller Avatar" />
                                <div>
                                    <div class="fw-bold text-dark" id="modalSellerName">Seller Name</div>
                                    <div class="small text-muted" id="modalSellerBranch">Branch & Semester</div>
                                    <div class="fs-8 text-muted" id="modalSellerPhone"><i class="bi bi-telephone me-1"></i> +91 ...</div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-success rounded-3 fw-bold py-2 d-flex align-items-center justify-content-center gap-2" id="modalBuyNowBtn">
                                <i class="bi bi-lightning-charge-fill"></i>
                                <span>Buy & Pay Now (UPI / Card / Cash)</span>
                            </button>
                            <button type="button" class="btn btn-primary rounded-3 fw-semibold py-2 d-flex align-items-center justify-content-center gap-2" id="modalStartChatBtn">
                                <i class="bi bi-chat-dots-fill"></i>
                                <span>Start Product Chat with Seller</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary rounded-3 btn-sm" data-bs-dismiss="modal">
                                Close
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. REAL-TIME CHAT SIMULATION MODAL (R.6.1, R.6.2, R.6.5) -->
<div class="modal fade" id="chatModal" tabindex="-1" aria-labelledby="chatModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <!-- Header: Seller info -->
            <div class="modal-header bg-primary text-white p-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100" id="chatSellerAvatar" class="rounded-circle border border-white" width="38" height="38" alt="Seller">
                        <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-white rounded-circle"></span>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-white" id="chatSellerName">Aarav Patel</h6>
                        <span class="fs-8 text-white-50" id="chatSellerStatus">Online | Comp. Engg (Sem 5)</span>
                    </div>
                </div>
