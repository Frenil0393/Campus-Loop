                        </ul>

                        <!-- Method Tabs Content -->
                        <div class="tab-content" id="paymentMethodTabsContent">
                            <!-- 1. UPI / QR CODE TAB -->
                            <div class="tab-pane fade show active" id="tab-upi" role="tabpanel">
                                <div class="text-center p-3 border rounded-3 bg-white mb-3">
                                    <div class="qr-code-wrapper mx-auto mb-2 p-2 border rounded-3 bg-white shadow-xs" style="width: 170px; height: 170px;">
                                        <img src="" id="payQrCodeImg" class="w-100 h-100" alt="UPI QR Code">
                                    </div>
                                    <div class="fs-9 text-muted mb-1">Scan with any UPI App:</div>
                                    <div class="d-flex justify-content-center gap-2 mb-2">
                                        <span class="badge bg-light text-dark border px-2 py-1"><i class="bi bi-google text-danger me-1"></i>GPay</span>
                                        <span class="badge bg-light text-dark border px-2 py-1"><i class="bi bi-phone text-primary me-1"></i>PhonePe</span>
                                        <span class="badge bg-light text-dark border px-2 py-1"><i class="bi bi-wallet2 text-info me-1"></i>Paytm</span>
                                        <span class="badge bg-light text-dark border px-2 py-1">BHIM</span>
                                    </div>
                                    <!-- Seller UPI ID with copy button -->
                                    <div class="input-group input-group-sm w-75 mx-auto">
                                        <span class="input-group-text bg-light text-muted fs-8">UPI ID</span>
                                        <input type="text" class="form-control text-center fw-bold fs-8" id="paySellerUpiId" readonly value="seller@okddu">
                                        <button class="btn btn-outline-secondary" type="button" id="copyUpiIdBtn" title="Copy UPI ID">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-success w-100 py-2 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2" id="submitUpiPaymentBtn">
                                    <i class="bi bi-check2-circle fs-5"></i>
                                    <span>I Have Paid via UPI &bull; Confirm Order</span>
                                </button>
                            </div>

                            <!-- 2. CARD TAB -->
                            <div class="tab-pane fade" id="tab-card" role="tabpanel">
                                <form id="cardPaymentForm" class="row g-2">
                                    <div class="col-12">
                                        <label class="form-label fs-8 fw-semibold mb-1">Card Number</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light"><i class="bi bi-credit-card-2-front"></i></span>
                                            <input type="text" class="form-control" id="cardNumInput" placeholder="4532 &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 8920" maxlength="19" required>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label fs-8 fw-semibold mb-1">Expiry Date</label>
                                        <input type="text" class="form-control form-control-sm" id="cardExpiryInput" placeholder="MM/YY" maxlength="5" required>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label fs-8 fw-semibold mb-1">CVV</label>
                                        <input type="password" class="form-control form-control-sm" id="cardCvvInput" placeholder="123" maxlength="3" required>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fs-8 fw-semibold mb-1">Name on Card</label>
                                        <input type="text" class="form-control form-control-sm" id="cardNameInput" placeholder="Aarav Patel" required>
                                    </div>
                                    <div class="col-12 mt-3">
                                        <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-bold" id="submitCardPaymentBtn">
                                            <span>Pay Now Securely</span>
                                        </button>
                                    </div>
                                </form>
                            </div>

                            <!-- 3. NETBANKING TAB -->
                            <div class="tab-pane fade" id="tab-netbanking" role="tabpanel">
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="p-2 border rounded-3 text-center cursor-pointer bank-select-card active" data-bank="State Bank of India">
                                            <i class="bi bi-bank text-primary fs-5"></i>
                                            <div class="fs-8 fw-semibold mt-1">SBI</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 border rounded-3 text-center cursor-pointer bank-select-card" data-bank="HDFC Bank">
                                            <i class="bi bi-bank text-danger fs-5"></i>
                                            <div class="fs-8 fw-semibold mt-1">HDFC</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 border rounded-3 text-center cursor-pointer bank-select-card" data-bank="ICICI Bank">
                                            <i class="bi bi-bank text-warning fs-5"></i>
                                            <div class="fs-8 fw-semibold mt-1">ICICI</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 border rounded-3 text-center cursor-pointer bank-select-card" data-bank="Bank of Baroda">
                                            <i class="bi bi-bank text-info fs-5"></i>
                                            <div class="fs-8 fw-semibold mt-1">BOB</div>
                                        </div>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary w-100 py-2 rounded-3 fw-bold" id="submitNetBankingBtn">
                                    <span>Proceed to Bank Portal</span>
                                </button>
                            </div>

                            <!-- 4. CASH ON HANDOVER TAB -->
                            <div class="tab-pane fade" id="tab-cash" role="tabpanel">
                                <div class="p-3 border rounded-3 bg-light mb-3">
                                    <div class="d-flex align-items-center gap-2 mb-2 text-dark">
                                        <i class="bi bi-cash-coin fs-4 text-success"></i>
                                        <h6 class="fw-bold mb-0">Cash on Physical Meeting</h6>
                                    </div>
                                    <p class="small text-muted mb-2">
                                        You and the seller will meet in person at the campus meeting spot. You inspect the item, hand over physical cash, and share the 4-digit security code.
                                    </p>
                                    <ul class="fs-9 text-muted ps-3 mb-0">
                                        <li>No advance online transfer needed.</li>
                                        <li>Meet in daylight at the Central Library Lawn or Canteen.</li>
                                    </ul>
                                </div>
                                <button type="button" class="btn btn-success w-100 py-2 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2" id="submitCashPaymentBtn">
                                    <i class="bi bi-hand-thumbs-up-fill"></i>
                                    <span>Confirm Cash Handover & Generate OTP</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loading Processing Screen -->
            <div class="modal-body p-5 text-center" id="paymentLoadingScreen" style="display: none;">
                <div class="spinner-border text-primary mb-3" style="width: 3.5rem; height: 3.5rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Verifying Transaction...</h5>
                <p class="text-muted small">Communicating with CampusLoop settlement network and creating handover token</p>
            </div>

            <!-- Success / Digital Printable Receipt Screen -->
            <div class="modal-body p-4" id="paymentSuccessScreen" style="display: none;">
                <div class="text-center mb-3">
                    <div class="success-checkmark-wrapper mx-auto mb-2 d-flex align-items-center justify-content-center rounded-circle bg-success text-white shadow" style="width: 60px; height: 60px;">
                        <i class="bi bi-check-lg fs-1"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1" id="receiptSuccessTitle">Payment Successful!</h4>
                    <p class="text-muted small mb-0" id="receiptSuccessSubtitle">Your campus order has been confirmed.</p>
                </div>

                <!-- Printable Receipt Card -->
                <div class="card border border-2 border-primary-subtle rounded-4 p-3 bg-light mb-3" id="printableReceiptCard">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-repeat text-primary fs-5"></i>
                            <strong class="text-dark">CampusLoop Invoice Receipt</strong>
                        </div>
                        <span class="badge bg-success" id="receiptStatusBadge">PAID &bull; VERIFIED</span>
                    </div>

                    <div class="row g-2 small">
                        <div class="col-6">
                            <span class="text-muted">Transaction ID:</span>
                            <div class="fw-bold text-dark font-monospace" id="receiptTxnId">TXN-LOOP-000000</div>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted">Order ID:</span>
                            <div class="fw-bold text-dark font-monospace" id="receiptOrderId">ORD-2026-0000</div>
                        </div>
                        <div class="col-6">
                            <span class="text-muted">Product:</span>
                            <div class="fw-bold text-dark" id="receiptProductName">Product Name</div>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted">Amount Paid:</span>
                            <div class="fw-extrabold text-primary fs-6" id="receiptAmount">₹0</div>
                        </div>
                        <div class="col-6">
                            <span class="text-muted">Seller:</span>
                            <div class="fw-semibold text-dark" id="receiptSeller">Seller Name</div>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted">Meeting Location:</span>
                            <div class="fw-semibold text-dark" id="receiptLocation">Campus Location</div>
                        </div>
                    </div>

                    <!-- 4-Digit Handshake OTP Box -->
                    <div class="p-3 bg-white rounded-3 border text-center mt-3 shadow-xs">
                        <span class="fs-9 text-uppercase text-muted fw-bold">Handover Exchange OTP</span>
                        <div class="display-6 fw-extrabold text-primary letter-spacing-2 my-1" id="receiptOtp">7842</div>
                        <div class="fs-9 text-muted">
                            <i class="bi bi-shield-lock-fill text-warning me-1"></i>
                            Give this 4-digit code to the seller when you inspect the item in person.
                        </div>
                    </div>
                </div>

                <!-- Footer Buttons -->
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary flex-grow-1 rounded-3" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i> Print / Save Receipt
                    </button>
                    <button type="button" class="btn btn-primary flex-grow-1 rounded-3 fw-bold" id="receiptDoneBtn">
                        Back to Marketplace
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

