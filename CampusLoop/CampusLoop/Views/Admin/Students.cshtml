@model List<CampusLoop.Models.StudentUser>
@{
    ViewData["Title"] = "Student Management (R.9)";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Student Management (R.9)</h3>
            <p class="text-muted small mb-0">View registered students, inspect student profiles, and remove invalid accounts</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-muted text-uppercase">
                        <th class="ps-4">Student</th>
                        <th>College Email</th>
                        <th>Phone Number</th>
                        <th>Branch & Semester</th>
                        <th>Active Listings</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@s.AvatarUrl" class="rounded-circle border" width="40" height="40" alt="@s.FullName" />
                                    <div>
                                        <div class="fw-bold text-dark">@s.FullName</div>
                                        <span class="badge bg-success-subtle text-success fs-9">Student</span>
                                    </div>
                                </div>
                            </td>
                            <td class="small">@s.CollegeEmail</td>
                            <td class="small">@s.PhoneNumber</td>
                            <td class="small">
                                <div class="fw-semibold">@s.Branch</div>
                                <div class="text-muted fs-8">@s.Semester</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@(s.Products?.Count ?? 0) Items</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="StudentDetails" asp-route-id="@s.Id" class="btn btn-outline-primary" title="View Student Details (R.9.2)">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <!-- Remove Invalid Student (R.9.3) -->
                                    <form asp-action="RemoveStudent" method="post" class="d-inline" onsubmit="return confirm('Remove student @s.FullName and all their listings? (R.9.3)');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <button type="submit" class="btn btn-outline-danger" title="Remove Invalid Student (R.9.3)">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
