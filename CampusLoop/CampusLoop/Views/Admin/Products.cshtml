@model List<CampusLoop.Models.Product>
@{
    ViewData["Title"] = "Marketplace Products Moderation (R.10)";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-box-seam-fill text-success me-2"></i>Product Management (R.10)</h3>
            <p class="text-muted small mb-0">Inspect marketplace products, moderate listings, and remove inappropriate items</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-muted text-uppercase">
                        <th class="ps-4">Product</th>
                        <th>Seller (Student)</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Meeting Point</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var img = p.ImageUrls.FirstOrDefault() ?? "https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=100";
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@img" class="rounded-3 border" width="48" height="48" style="object-fit: cover;" alt="@p.Name">
                                    <div>
                                        <div class="fw-bold text-dark">@p.Name</div>
                                        <div class="fs-9 text-muted">Condition: @p.Condition</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small fw-semibold">@p.Seller?.FullName</div>
                                <div class="fs-9 text-muted">@p.Seller?.Branch</div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@p.Category?.Name</span></td>
                            <td class="fw-bold text-primary">₹@p.Price.ToString("N0")</td>
                            <td>
                                <span class="badge @(p.Status == "AVAILABLE" ? "bg-success" : "bg-secondary")">@p.Status</span>
                            </td>
                            <td class="small text-muted">@p.CampusLocation</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-secondary" title="View Product Details (R.10.2)">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <!-- Remove Product (R.10.3) -->
                                    <form asp-action="RemoveProduct" method="post" class="d-inline" onsubmit="return confirm('Remove product @p.Name from marketplace? (R.10.3)');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="btn btn-outline-danger" title="Remove Product (R.10.3)">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
