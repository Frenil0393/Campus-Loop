@model CampusLoop.Models.StudentUser
@{
    ViewData["Title"] = "Student Details - " + Model.FullName;
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-person-lines-fill text-primary me-2"></i>Student Details (R.9.2)</h3>
            <p class="text-muted small mb-0">Inspect complete profile and posted listings of student</p>
        </div>
        <a asp-action="Students" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Students
        </a>
    </div>

    <div class="row g-4">
        <!-- Student Info Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <img src="@Model.AvatarUrl" class="rounded-circle border border-2 border-primary mx-auto mb-3" width="90" height="90" alt="@Model.FullName">
                <h5 class="fw-bold mb-0">@Model.FullName</h5>
                <span class="badge bg-primary-subtle text-primary mt-1">@Model.Branch</span>

                <ul class="list-group list-group-flush text-start small mt-4 border rounded-3">
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Student ID:</span>
                        <span class="fw-bold font-monospace">@Model.Id</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Email:</span>
                        <span>@Model.CollegeEmail</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Phone:</span>
                        <span>@Model.PhoneNumber</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Semester:</span>
                        <span>@Model.Semester</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Registered On:</span>
                        <span>@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                    </li>
                </ul>

                <!-- Remove Button (R.9.3) -->
                <form asp-action="RemoveStudent" method="post" class="mt-4" onsubmit="return confirm('Remove student account?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger w-100 rounded-3">
                        <i class="bi bi-trash me-1"></i> Remove Invalid Student (R.9.3)
                    </button>
                </form>
            </div>
        </div>

        <!-- Student's Products Table -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h6 class="fw-bold mb-3 pb-2 border-bottom">Products Listed by this Student</h6>
                @if (Model.Products != null && Model.Products.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Products)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@p.Name</td>
                                        <td>@p.Category?.Name</td>
                                        <td class="fw-bold text-primary">₹@p.Price.ToString("N0")</td>
                                        <td><span class="badge @(p.Status == "AVAILABLE" ? "bg-success" : "bg-secondary")">@p.Status</span></td>
                                        <td class="text-end">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary py-0">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">This student has no active or sold product listings.</p>
                }
            </div>
        </div>
    </div>
</div>
