@model List<CampusLoop.Models.Category>
@{
    ViewData["Title"] = "Category Management (R.11)";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-tags-fill text-warning me-2"></i>Category Management (R.11)</h3>
            <p class="text-muted small mb-0">Manage product categories used by students when listing academic items</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary rounded-pill px-3 shadow-xs" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                <i class="bi bi-plus-circle-fill me-1"></i> Add Category (R.11.1)
            </button>
            <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-muted text-uppercase">
                        <th class="ps-4">Icon & Name</th>
                        <th>Slug</th>
                        <th>Description</th>
                        <th>Assigned Products</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="stat-icon bg-light text-primary rounded-3 p-2">
                                        <i class="bi @cat.IconClass fs-5"></i>
                                    </div>
                                    <div class="fw-bold text-dark">@cat.Name</div>
                                </div>
                            </td>
                            <td class="font-monospace small text-muted">@cat.Slug</td>
                            <td class="small text-muted" style="max-width: 280px;">@cat.Description</td>
                            <td>
                                <span class="badge bg-light text-dark border">@(cat.Products?.Count ?? 0) Products</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <!-- Edit Category (R.11.2) -->
                                    <button type="button" class="btn btn-outline-secondary" 
                                            onclick="openEditCategoryModal(@cat.Id, '@cat.Name', '@cat.Slug', '@cat.IconClass', '@cat.Description')">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <!-- Delete Category (R.11.3) -->
                                    <form asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Delete category @cat.Name? (R.11.3)');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-outline-danger" title="Delete Category (R.11.3)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ADD CATEGORY MODAL (R.11.1) -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mb-0">Add New Category (R.11.1)</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 pt-2">
                <form asp-action="AddCategory" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Category Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Lab Equipment & Coats" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Slug (URL identifier)</label>
                        <input type="text" name="slug" class="form-control" placeholder="e.g. lab-equipment" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Bootstrap Icon Class</label>
                        <input type="text" name="iconClass" class="form-control" placeholder="e.g. bi-eyedropper" value="bi-box-seam" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Brief summary of items in this category..."></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-bold">Add Category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- EDIT CATEGORY MODAL (R.11.2) -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mb-0">Edit Category (R.11.2)</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 pt-2">
                <form asp-action="EditCategory" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="editCatId" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Category Name</label>
                        <input type="text" name="name" id="editCatName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Slug</label>
                        <input type="text" name="slug" id="editCatSlug" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Bootstrap Icon Class</label>
                        <input type="text" name="iconClass" id="editCatIcon" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea name="description" id="editCatDesc" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-bold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditCategoryModal(id, name, slug, icon, desc) {
            document.getElementById('editCatId').value = id;
            document.getElementById('editCatName').value = name;
            document.getElementById('editCatSlug').value = slug;
            document.getElementById('editCatIcon').value = icon;
            document.getElementById('editCatDesc').value = desc;
            new bootstrap.Modal(document.getElementById('editCategoryModal')).show();
        }
    </script>
}
