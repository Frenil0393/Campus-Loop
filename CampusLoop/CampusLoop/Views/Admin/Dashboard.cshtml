@{
    ViewData["Title"] = "Admin Dashboard (R.12)";
    var recentProducts = ViewBag.RecentProducts as List<CampusLoop.Models.Product> ?? new();
    var recentStudents = ViewBag.RecentStudents as List<CampusLoop.Models.StudentUser> ?? new();
}

<div class="container my-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-warning me-2"></i>Campus Administrator Dashboard (R.12)</h3>
            <p class="text-muted small mb-0">Overview and governance of CampusLoop marketplace activity</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Students" class="btn btn-outline-primary rounded-pill btn-sm">
                <i class="bi bi-people me-1"></i> Manage Students (R.9)
            </a>
            <a asp-action="Products" class="btn btn-outline-success rounded-pill btn-sm">
                <i class="bi bi-box-seam me-1"></i> Manage Products (R.10)
            </a>
            <a asp-action="Categories" class="btn btn-outline-dark rounded-pill btn-sm">
                <i class="bi bi-tags me-1"></i> Manage Categories (R.11)
            </a>
        </div>
    </div>

    <!-- Statistics Cards (R.12.1) -->
    <div class="row g-3 mb-5">
        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fs-8 text-uppercase fw-bold">Total Students (R.12.1)</span>
                        <h2 class="fw-bold text-dark mb-0 mt-1">@ViewBag.TotalStudents</h2>
                        <span class="fs-9 text-success"><i class="bi bi-arrow-up-right me-1"></i>Verified college accounts</span>
                    </div>
                    <div class="stat-icon bg-primary-subtle text-primary p-3 rounded-4 fs-3">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fs-8 text-uppercase fw-bold">Total Products Listed</span>
                        <h2 class="fw-bold text-dark mb-0 mt-1">@ViewBag.TotalProducts</h2>
                        <span class="fs-9 text-muted">Across all semesters</span>
                    </div>
                    <div class="stat-icon bg-success-subtle text-success p-3 rounded-4 fs-3">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fs-8 text-uppercase fw-bold">Available Listings</span>
                        <h2 class="fw-bold text-success mb-0 mt-1">@ViewBag.AvailableProducts</h2>
                        <span class="fs-9 text-success">Live on marketplace</span>
                    </div>
                    <div class="stat-icon bg-info-subtle text-info p-3 rounded-4 fs-3">
                        <i class="bi bi-bag-check-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fs-8 text-uppercase fw-bold">Sold Items History</span>
                        <h2 class="fw-bold text-secondary mb-0 mt-1">@ViewBag.SoldProducts</h2>
                        <span class="fs-9 text-muted">Archived completed deals</span>
                    </div>
                    <div class="stat-icon bg-secondary-subtle text-secondary p-3 rounded-4 fs-3">
                        <i class="bi bi-check-all"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fs-8 text-uppercase fw-bold">Active Categories</span>
                        <h2 class="fw-bold text-dark mb-0 mt-1">@ViewBag.TotalCategories</h2>
                        <span class="fs-9 text-primary">Academic & hostel groups</span>
                    </div>
                    <div class="stat-icon bg-warning-subtle text-warning p-3 rounded-4 fs-3">
                        <i class="bi bi-tags-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fs-8 text-uppercase fw-bold">Settled Deals (Orders)</span>
                        <h2 class="fw-bold text-primary mb-0 mt-1">@ViewBag.TotalOrders</h2>
                        <span class="fs-9 text-success">Verified with Handshake OTP</span>
                    </div>
                    <div class="stat-icon bg-danger-subtle text-danger p-3 rounded-4 fs-3">
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tables: Recent Listings & Recent Students -->
    <div class="row g-4">
        <!-- Recent Products -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-box-seam text-primary me-2"></i>Recent Marketplace Listings</h6>
                    <a asp-action="Products" class="small text-decoration-none">View All &rarr;</a>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th>Seller</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in recentProducts)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark text-truncate" style="max-width: 170px;">@p.Name</div>
                                    </td>
                                    <td>@p.Seller?.FullName</td>
                                    <td class="fw-bold text-primary">₹@p.Price.ToString("N0")</td>
                                    <td><span class="badge @(p.Status == "AVAILABLE" ? "bg-success" : "bg-secondary")">@p.Status</span></td>
                                    <td class="text-end">
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-light py-0">Inspect</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Students -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-people text-primary me-2"></i>Newly Registered Students</h6>
                    <a asp-action="Students" class="small text-decoration-none">View All &rarr;</a>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var s in recentStudents)
                    {
                        <div class="list-group-item px-0 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                <img src="@s.AvatarUrl" class="rounded-circle" width="34" height="34" alt="@s.FullName" />
                                <div class="overflow-hidden">
                                    <div class="fw-bold fs-8 text-dark text-truncate">@s.FullName</div>
                                    <div class="fs-9 text-muted text-truncate">@s.Branch (@s.Semester)</div>
                                </div>
                            </div>
                            <a asp-action="StudentDetails" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary py-0 px-2 fs-8">Details</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
