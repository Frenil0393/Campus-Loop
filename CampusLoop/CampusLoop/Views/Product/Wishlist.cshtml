@model List<CampusLoop.Models.WishlistItem>
@{
    ViewData["Title"] = "My Saved Wishlist";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-heart-fill text-danger me-2"></i>My Saved Wishlist</h3>
            <p class="text-muted small mb-0">Track items you are interested in buying from fellow students</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Browse Marketplace
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var p = item.Product;
                if (p != null)
                {
                    var img = p.ImageUrls.FirstOrDefault() ?? "https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=500";
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card bg-white">
                            <div class="product-img-wrapper position-relative">
                                <img src="@img" class="card-img-top product-img" alt="@p.Name">
                                <span class="badge @(p.Status == "AVAILABLE" ? "bg-success" : "bg-secondary") position-absolute top-0 start-0 m-3">
                                    @p.Status
                                </span>
                            </div>
                            <div class="card-body p-3 d-flex flex-column">
                                <span class="badge bg-primary-subtle text-primary rounded-pill small align-self-start mb-1">
                                    @(p.Category?.Name ?? "Campus Item")
                                </span>
                                <h6 class="fw-bold text-dark text-truncate-2 mb-1">@p.Name</h6>
                                <div class="text-muted fs-8 mb-2"><i class="bi bi-geo-alt text-danger me-1"></i>@p.CampusLocation</div>
                                <div class="d-flex align-items-baseline gap-2 mb-3 mt-auto">
                                    <span class="fs-5 fw-extrabold text-primary">₹@p.Price.ToString("N0")</span>
                                </div>
                                <div class="d-grid gap-2">
                                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-primary btn-sm rounded-3 fw-semibold">
                                        View Details & Buy
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="empty-icon-wrapper mx-auto mb-3">
                <i class="bi bi-heart text-muted fs-1"></i>
            </div>
            <h5 class="fw-bold">Your Wishlist is Empty</h5>
            <p class="text-muted small max-w-400 mx-auto">
                Explore the marketplace and click the heart icon on items you'd like to save for later.
            </p>
            <div class="mt-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-bag-check me-1"></i> Explore Marketplace
                </a>
            </div>
        </div>
    }
</div>
