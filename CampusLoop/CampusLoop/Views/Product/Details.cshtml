@model CampusLoop.Models.Product
@{
    ViewData["Title"] = Model.Name + " - Details (R.2.2)";
    var isWishlisted = ViewBag.IsWishlisted == true;
    var isOwner = ViewBag.IsOwner == true;
    var primaryImage = Model.ImageUrls.FirstOrDefault() ?? "https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=800";
}

<div class="container my-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Marketplace</a></li>
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" asp-route-category="@Model.Category?.Slug" class="text-decoration-none">@Model.Category?.Name</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Left: Product Image Gallery (R.14.2) -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden p-3 bg-white mb-3">
                <div class="product-detail-main-img-box rounded-3 overflow-hidden bg-light mb-3 text-center" style="height: 380px;">
                    <img src="@primaryImage" id="mainDetailImg" class="w-100 h-100 object-fit-contain" alt="@Model.Name" />
                </div>
                <!-- 3-4 Photos Thumbnail Gallery (R.14.2) -->
                <div class="d-flex gap-2 thumbnail-row">
                    @for (int i = 0; i < Model.ImageUrls.Count; i++)
                    {
                        var img = Model.ImageUrls[i];
                        <img src="@img" 
                             class="detail-thumb-img rounded-2 border cursor-pointer @(i == 0 ? "border-primary" : "")" 
                             style="width: 75px; height: 75px; object-fit: cover;" 
                             onclick="switchMainImg('@img', this)"
                             alt="Thumbnail @(i+1)" />
                    }
                </div>
            </div>
        </div>

        <!-- Right: Product Info & Actions (R.2.2, R.7.1) -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <!-- Status & Category -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill">
                        @(Model.Category?.Name ?? "Campus Gear")
                    </span>
                    <span class="badge @(Model.Status == "AVAILABLE" ? "bg-success" : "bg-secondary") px-3 py-2 rounded-pill">
                        <i class="bi bi-circle-fill me-1 small"></i> @Model.Status
                    </span>
                </div>

                <h3 class="fw-bold text-dark mb-2">@Model.Name</h3>

                <div class="d-flex align-items-baseline gap-2 mb-3">
                    <span class="display-6 fw-extrabold text-primary">₹@Model.Price.ToString("N0")</span>
                    <span class="badge bg-light text-muted border">Student Price</span>
                </div>

                <div class="row g-2 mb-3 small">
                    <div class="col-6">
                        <div class="p-2 rounded-3 bg-light">
                            <span class="text-muted d-block fs-8">Item Condition:</span>
                            <strong class="text-dark">@Model.Condition</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded-3 bg-light">
                            <span class="text-muted d-block fs-8">Meeting Handover Spot:</span>
                            <strong class="text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.CampusLocation</strong>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold fs-8 text-uppercase text-muted mb-1">Item Description</h6>
                <p class="text-muted small mb-4" style="white-space: pre-line;">
                    @Model.Description
                </p>

                <!-- Seller Profile Card (R.7.1) -->
                <div class="seller-card p-3 rounded-4 border bg-light mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fs-9 text-uppercase text-muted fw-bold"><i class="bi bi-person-badge me-1"></i> Verified Student Seller</span>
                        <span class="badge bg-success-subtle text-success fs-9">Enrolled Student</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <img src="@(Model.Seller?.AvatarUrl ?? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100")" 
                             class="rounded-circle border" width="50" height="50" alt="@Model.Seller?.FullName" />
                        <div>
                            <h6 class="fw-bold text-dark mb-0">@Model.Seller?.FullName</h6>
                            <div class="small text-muted">@Model.Seller?.Branch &bull; @Model.Seller?.Semester</div>
                            <div class="fs-8 text-muted mt-1">
                                <i class="bi bi-telephone me-1"></i> @Model.Seller?.PhoneNumber &bull; 
                                <i class="bi bi-envelope ms-1 me-1"></i> @Model.Seller?.CollegeEmail
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-grid gap-2">
                    @if (Model.Status == "AVAILABLE")
                    {
                        <!-- Buy & Pay Button (Links to Safe Campus Checkout) -->
                        <a asp-controller="Payment" asp-action="Checkout" asp-route-productId="@Model.Id" 
                           class="btn btn-success rounded-3 fw-bold py-2 shadow-xs d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-lightning-charge-fill"></i>
                            <span>Buy & Pay ₹@Model.Price.ToString("N0") (UPI / Cash / Card)</span>
                        </a>

                        @if (!isOwner)
                        {
                            <!-- Chat with Seller (R.6.1) -->
                            <a asp-controller="Chat" asp-action="Conversation" asp-route-productId="@Model.Id" asp-route-sellerId="@Model.SellerId" 
                               class="btn btn-primary rounded-3 fw-semibold py-2">
                                <i class="bi bi-chat-dots-fill me-1"></i> Real-time Chat with Seller (R.6)
                            </a>
                        }
                    }
                    else
                    {
                        <div class="alert alert-secondary text-center fw-bold py-2 mb-0">
                            <i class="bi bi-bag-x me-1"></i> This item has been SOLD
                        </div>
                    }

                    <div class="d-flex gap-2">
                        @if (!isOwner)
                        {
                            <button type="button" class="btn btn-outline-danger flex-grow-1 rounded-3" onclick="toggleWishlistDetails(@Model.Id, this)">
                                <i class="bi @(isWishlisted ? "bi-heart-fill text-danger" : "bi-heart") me-1"></i>
                                <span>@(isWishlisted ? "In Your Wishlist" : "Add to Wishlist")</span>
                            </button>
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary flex-grow-1 rounded-3">
                                <i class="bi bi-pencil me-1"></i> Edit Product (R.3.3)
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchMainImg(url, thumb) {
            document.getElementById('mainDetailImg').src = url;
            document.querySelectorAll('.detail-thumb-img').forEach(t => t.classList.remove('border-primary'));
            thumb.classList.add('border-primary');
        }

        async function toggleWishlistDetails(id, btn) {
            try {
                const res = await fetch(`/Product/ToggleWishlist?productId=${id}`, { method: 'POST' });
                if (res.status === 401) {
                    window.location.href = '/Account/Login';
                    return;
                }
                const data = await res.json();
                if (data.success) {
                    const icon = btn.querySelector('i');
                    const span = btn.querySelector('span');
                    if (data.isWishlisted) {
                        icon.className = 'bi bi-heart-fill text-danger me-1';
                        span.textContent = 'In Your Wishlist';
                    } else {
                        icon.className = 'bi bi-heart me-1';
                        span.textContent = 'Add to Wishlist';
                    }
                }
            } catch (err) {
                console.error(err);
            }
        }
    </script>
}
