@model List<CampusLoop.Models.Product>
@{
    ViewData["Title"] = "My Listed Products (R.3.2)";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-box-seam text-primary me-2"></i>My Listed Products (R.3.2)</h3>
            <p class="text-muted small mb-0">Manage and track your active campus sales and sold item history</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-xs">
            <i class="bi bi-plus-circle-fill me-1"></i> Post New Item (R.3.1)
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th class="ps-4">Product Details</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Status (R.3.6)</th>
                            <th>Meeting Point</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            var img = p.ImageUrls.FirstOrDefault() ?? "https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=100";
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@img" class="rounded-3 border" width="54" height="54" style="object-fit: cover;" alt="@p.Name">
                                        <div>
                                            <a asp-action="Details" asp-route-id="@p.Id" class="fw-bold text-dark text-decoration-none hover-link">
                                                @p.Name
                                            </a>
                                            <div class="fs-8 text-muted">Condition: @p.Condition &bull; Posted @p.CreatedAt.ToString("dd MMM yyyy")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(p.Category?.Name ?? "General")</span>
                                </td>
                                <td>
                                    <span class="fw-extrabold text-primary fs-6">₹@p.Price.ToString("N0")</span>
                                </td>
                                <td>
                                    @if (p.Status == "AVAILABLE")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> AVAILABLE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">
                                            <i class="bi bi-bag-check-fill me-1"></i> SOLD
                                        </span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    <i class="bi bi-geo-alt text-danger me-1"></i>@p.CampusLocation
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        @if (p.Status == "AVAILABLE")
                                        {
                                            <!-- Mark as Sold Button (R.3.5) -->
                                            <form asp-action="MarkSold" method="post" class="d-inline" onsubmit="return confirm('Mark this product as SOLD? (R.3.5)');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <button type="submit" class="btn btn-outline-warning" title="Mark as Sold (R.3.5)">
                                                    <i class="bi bi-check-circle me-1"></i> Mark Sold
                                                </button>
                                            </form>
                                        }

                                        <!-- Edit Product (R.3.3) -->
                                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary" title="Edit Product">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Delete Product (R.3.4) -->
                                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this product? (R.3.4)');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-outline-danger" title="Delete Product">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="empty-icon-wrapper mx-auto mb-3">
                <i class="bi bi-box-seam text-muted fs-1"></i>
            </div>
            <h5 class="fw-bold">No Products Listed Yet</h5>
            <p class="text-muted small max-w-400 mx-auto">
                You haven't posted any items for sale. Declutter your desk or hostel room and help fellow students!
            </p>
            <div class="mt-2">
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-plus-circle me-1"></i> Post Your First Product (R.3.1)
                </a>
            </div>
        </div>
    }
</div>
